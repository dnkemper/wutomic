#!/bin/bash

## Description: Sync database and files from Pantheon atomic-artsci to your local DDEV environment
## Usage: pantheon-sync [environment] [--skip-files] [--skip-backup] [--skip-local-backup] [--skip-updates] [--rsync] [--direct-dump]
## Example: ddev pantheon-sync prod
## Example: ddev pantheon-sync dev --skip-files
## Example: ddev pantheon-sync live --rsync --direct-dump

NOW=$(TZ=America/Chicago date +"%Y-%m-%d-%H-%M-%S")
SCRIPT_START=$(date +%s)
red=$(tput setaf 1)$(tput bold)
green=$(tput setaf 2)
yellow=$(tput setaf 3)$(tput bold)
blue=$(tput setaf 4)
magenta=$(tput setaf 5)$(tput bold)
NC=$(tput sgr0)

# Hardcoded site name
SITE_NAME="atomic-artsci"

# Default flags
SKIP_FILES=false
SKIP_BACKUP=true
SKIP_LOCAL_BACKUP=false
SKIP_UPDATES=false
USE_RSYNC=false
DIRECT_DUMP=false

# Timing helper
step_start() {
  STEP_START=$(date +%s)
  echo -e "\n${blue}▶ $1${NC}"
}
step_done() {
  local elapsed=$(( $(date +%s) - STEP_START ))
  echo -e "${green}  ✓ Done (${elapsed}s)${NC}"
}

echo -e "\n${yellow}>>>>>${NC} ${magenta}${NOW}${NC} ${green}Running Atomic Arts & Sciences Sync${NC} ${yellow}<<<<<${NC}\n"

# Function to map environment names
map_to_pantheon_env() {
  case $1 in
    dev|1) echo "dev";;
    stage|test|2) echo "test";;
    prod|live|3) echo "live";;
    *) echo "";;
  esac
}

prompt_for_environment() {
  PS3="Select the environment you want to sync from: "
  options=("dev" "stage (test)" "prod (live)")

  select env_option in "${options[@]}"; do
    case $REPLY in
      1) echo "dev"; return;;
      2) echo "test"; return;;
      3) echo "live"; return;;
      *) echo "${red}Invalid selection. Please try again.${NC}";;
    esac
  done
}

# Parse flags
POSITIONAL_ARGS=()
while [[ "$#" -gt 0 ]]; do
  case $1 in
    --skip-files) SKIP_FILES=true; shift;;
    --skip-backup) SKIP_BACKUP=true; shift;;
    --skip-local-backup) SKIP_LOCAL_BACKUP=true; shift;;
    --skip-updates) SKIP_UPDATES=true; shift;;
    --rsync) USE_RSYNC=true; shift;;
    --direct-dump) DIRECT_DUMP=true; shift;;
    *) POSITIONAL_ARGS+=("$1"); shift;;
  esac
done
set -- "${POSITIONAL_ARGS[@]}"

# Parse environment argument or prompt
if [ -z "$1" ]; then
  PANTHEON_ENV=$(prompt_for_environment)
else
  PANTHEON_ENV=$(map_to_pantheon_env "$1")
  if [[ -z "$PANTHEON_ENV" ]]; then
    echo "${red}Invalid environment argument. Use: dev, stage, or prod${NC}"
    exit 1
  fi
fi

# Verify Terminus auth
step_start "Verifying Terminus authentication..."
if ! terminus auth:whoami &>/dev/null; then
  echo "${red}Not authenticated with Terminus. Please run: terminus auth:login${NC}"
  exit 1
fi

if ! terminus site:info "$SITE_NAME" &>/dev/null; then
  echo "${red}Site '$SITE_NAME' not found on Pantheon.${NC}"
  exit 1
fi
step_done

# Confirm selections
echo ""
echo "${yellow}========================================${NC}"
echo "${blue}Site:${NC}             $SITE_NAME"
echo "${blue}Environment:${NC}      $PANTHEON_ENV"
echo "${blue}Skip Files:${NC}       $SKIP_FILES"
echo "${blue}Use Rsync:${NC}        $USE_RSYNC"
echo "${blue}Direct SQL Dump:${NC}  $DIRECT_DUMP"
echo "${blue}Skip Updates:${NC}     $SKIP_UPDATES"
echo "${yellow}========================================${NC}"
echo ""

# ---------------------------------------------------------------------------
# Local backup (unless skipped)
# ---------------------------------------------------------------------------
if [ "$SKIP_LOCAL_BACKUP" = false ]; then
  step_start "Backing up current local database..."
  ddev export-db --gzip=false --file="atomic-artsci-backup-$NOW.sql"
  step_done
fi

# ---------------------------------------------------------------------------
# Database sync
# ---------------------------------------------------------------------------
if [ "$DIRECT_DUMP" = true ]; then
  step_start "Streaming live database dump from Pantheon..."
  terminus drush "$SITE_NAME.$PANTHEON_ENV" -- sql-dump --gzip \
    | ddev import-db
  step_done
else
  if [ "$SKIP_BACKUP" = false ]; then
    step_start "Creating backup on Pantheon..."
    terminus backup:create "$SITE_NAME.$PANTHEON_ENV" --element=db --keep-for=7
    step_done
  fi

  step_start "Getting database backup URL..."
  DB_BACKUP_URL=$(terminus backup:get "$SITE_NAME.$PANTHEON_ENV" --element=db)
  if [ -z "$DB_BACKUP_URL" ]; then
    echo "${red}Failed to get database backup URL${NC}"
    exit 1
  fi
  step_done

  # Kick off files download in parallel if needed
  if [ "$SKIP_FILES" = false ] && [ "$USE_RSYNC" = false ]; then
    step_start "Getting files backup URL..."
    FILES_BACKUP_URL=$(terminus backup:get "$SITE_NAME.$PANTHEON_ENV" --element=files)
    step_done

    if [ -n "$FILES_BACKUP_URL" ]; then
      step_start "Downloading files backup in background..."
      curl -sL "$FILES_BACKUP_URL" -o "/tmp/atomic-artsci-files-$NOW.tar.gz" &
      FILES_PID=$!
      echo "  (PID: $FILES_PID)"
    fi
  fi

  step_start "Downloading database backup..."
  curl -sL "$DB_BACKUP_URL" -o "/tmp/atomic-artsci-db-$NOW.sql.gz"
  if [ ! -s "/tmp/atomic-artsci-db-$NOW.sql.gz" ]; then
    echo "${red}Database download failed or file is empty${NC}"
    exit 1
  fi
  step_done

  step_start "Importing database..."
  if ddev import-db --file="/tmp/atomic-artsci-db-$NOW.sql.gz"; then
    rm -f "/tmp/atomic-artsci-db-$NOW.sql.gz"
  else
    echo "${red}Database import failed${NC}"
    exit 1
  fi
  step_done
fi

# ---------------------------------------------------------------------------
# File sync
# ---------------------------------------------------------------------------
if [ "$SKIP_FILES" = false ]; then
  if [ "$USE_RSYNC" = true ]; then
    step_start "Syncing files via rsync from Pantheon..."
    mkdir -p web/sites/default/files

    terminus env:wake "$SITE_NAME.$PANTHEON_ENV" 2>/dev/null

    SFTP_COMMAND=$(terminus connection:info "$SITE_NAME.$PANTHEON_ENV" --field=sftp_command 2>/dev/null)

    if [ -z "$SFTP_COMMAND" ]; then
      echo "${red}Could not get SFTP connection info.${NC}"
      echo "${yellow}Falling back to backup method...${NC}"
      USE_RSYNC=false
    else
      SFTP_PORT=$(echo "$SFTP_COMMAND" | grep -oP 'Port=\K[0-9]+')
      SFTP_HOST=$(echo "$SFTP_COMMAND" | awk '{print $NF}')

      rsync -rlvz --size-only --ipv4 --progress \
        --exclude='css' \
        --exclude='js' \
        --exclude='styles' \
        --exclude='php' \
        --exclude='xmlsitemap' \
        -e "ssh -p ${SFTP_PORT:-2222} -o StrictHostKeyChecking=no" \
        "$SFTP_HOST:files/" \
        "web/sites/default/files/"
      step_done
    fi
  fi

  if [ "$USE_RSYNC" = false ]; then
    mkdir -p web/sites/default/files

    if [ -n "$FILES_PID" ]; then
      step_start "Waiting for files download to complete..."
      wait "$FILES_PID"
      step_done
    elif [ -z "$FILES_BACKUP_URL" ]; then
      step_start "Getting files backup URL..."
      FILES_BACKUP_URL=$(terminus backup:get "$SITE_NAME.$PANTHEON_ENV" --element=files)
      step_done

      if [ -n "$FILES_BACKUP_URL" ]; then
        step_start "Downloading files backup..."
        curl -sL "$FILES_BACKUP_URL" -o "/tmp/atomic-artsci-files-$NOW.tar.gz"
        step_done
      fi
    fi

    if [ -s "/tmp/atomic-artsci-files-$NOW.tar.gz" ]; then
      step_start "Extracting files..."
      tar -xzf "/tmp/atomic-artsci-files-$NOW.tar.gz" --strip-components=1 -C "web/sites/default/files/"
      rm -f "/tmp/atomic-artsci-files-$NOW.tar.gz"
      step_done
    else
      echo "${yellow}  No files backup available, skipping.${NC}"
    fi
  fi
else
  echo -e "\n${yellow}Skipping file sync (--skip-files flag set)${NC}"
fi

# ---------------------------------------------------------------------------
# Post-import tasks
# ---------------------------------------------------------------------------
if [ "$SKIP_UPDATES" = false ]; then
  step_start "Running database updates..."
  ddev drush updb --yes
  step_done

  echo -e "${blue}Updating Composer packages${NC}"
  ddev composer update --lock
  ddev composer install

  step_start "Importing configuration..."
  if ! ddev drush cim --yes 2>/dev/null; then
    echo "${yellow}  Config import had errors, but continuing...${NC}"
  fi
  ddev drush config-split:activate local --yes 2>/dev/null
  step_done
else
  echo -e "\n${yellow}Skipping database updates and config import (--skip-updates flag set)${NC}"
fi

step_start "Enabling development settings..."
ddev dev-settings
step_done

step_start "Clearing Drupal cache..."
ddev drush cr
step_done

step_start "Generating login link..."
ddev drush uli
step_done

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
TOTAL_TIME=$(( $(date +%s) - SCRIPT_START ))
MINUTES=$(( TOTAL_TIME / 60 ))
SECONDS=$(( TOTAL_TIME % 60 ))

echo ""
echo "${green}========================================${NC}"
echo "${green}  Sync completed in ${MINUTES}m ${SECONDS}s${NC}"
echo "${green}========================================${NC}"
echo ""
if [ "$SKIP_LOCAL_BACKUP" = false ]; then
  echo "${yellow}Backup saved to:${NC} atomic-artsci-backup-$NOW.sql"
fi
echo ""
echo "${blue}Quick commands:${NC}"
echo "  ${yellow}ddev pantheon-sync prod${NC}                    Full sync from production"
echo "  ${yellow}ddev pantheon-sync dev --skip-files${NC}        DB only from dev"
echo "  ${yellow}ddev pantheon-sync prod --direct-dump --rsync --skip-local-backup --skip-updates${NC}"
echo "                                           Fastest repeat sync"
echo ""
