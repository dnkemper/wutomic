{#
/**
 * @file
 * Theme override for the Academic Calendar of Events view.
 *
 * Adds the calendar toolbar (subscribe to calendar, print semester, semester
 * stepper) and a search box above the event rows, to match the academic
 * calendar design.
 *
 * Extra variables provided by
 * washu_calendar_subscription_preprocess_views_view__academic_calendar_of_events():
 * - academic_calendar.label: Active semester label, e.g. "Summer 2026".
 * - academic_calendar.prev_url / .next_url: Stepper links (or null at ends).
 * - academic_calendar.subscribe_url / .subscribe_webcal: iCal feed links.
 * - academic_calendar.search_value: Current search term.
 * - academic_calendar.search_action: Form action for the search.
 * - academic_calendar.active_season / .active_year: Active term, for the
 *   hidden inputs that keep search scoped to the shown semester.
 *
 * @see template_preprocess_views_view()
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'academic-calendar',
  ]
%}
{{ attach_library('atomic_artsci/view-academic-calendar') }}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}{{ title_suffix }}
      <form class="academic-calendar__search" method="get" action="{{ academic_calendar.search_action }}" role="search">
    <label class="visually-hidden" for="academic-calendar-keys">{{ 'Search the academic calendar'|t }}</label>
    <input type="search" id="academic-calendar-keys" name="keys" value="{{ academic_calendar.search_value }}" placeholder="{{ 'Search events'|t }}" class="academic-calendar__search-input" />
        <button type="submit" class="academic-calendar__search-submit" aria-label="{{ 'Search'|t }}">
    <input type="hidden" name="semester" value="{{ academic_calendar.active_season }}" />
    <input type="hidden" name="year" value="{{ academic_calendar.active_year }}" />
      <svg class="academic-calendar__icon" role="presentation" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M416 208c0 45.9-14.9 88.3-40 122.7L502.6 457.4c12.5 12.5 12.5 32.8 0 45.3s-32.8 12.5-45.3 0L330.7 376c-34.4 25.2-76.8 40-122.7 40C93.1 416 0 322.9 0 208S93.1 0 208 0S416 93.1 416 208zM208 352a144 144 0 1 0 0-288 144 144 0 1 0 0 288z"/></svg>
    </button>
  </form>
  <div class="academic-calendar__bar academic-calendar__bar--top">

    {% if academic_calendar.subscribe_url %}
      <a href="{{ academic_calendar.subscribe_webcal }}" class="academic-calendar__action academic-calendar__subscribe">
        <svg class="academic-calendar__icon" role="presentation" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M0 64C0 46.3 14.3 32 32 32c229.8 0 416 186.2 416 416c0 17.7-14.3 32-32 32s-32-14.3-32-32C384 253.6 226.4 96 32 96C14.3 96 0 81.7 0 64zM0 416a64 64 0 1 1 128 0A64 64 0 1 1 0 416zM32 160c159.1 0 288 128.9 288 288c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-123.7-100.3-224-224-224c-17.7 0-32-14.3-32-32s14.3-32 32-32z"/></svg>
        <span>Subscribe to Calendar</span>
      </a>
    {% endif %}
    
  </div>

  <div class="academic-calendar__bar academic-calendar__bar--controls">
    <button type="button" class="academic-calendar__action academic-calendar__print js-academic-calendar-print">
      <svg class="academic-calendar__icon" role="presentation" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M128 0C92.7 0 64 28.7 64 64l0 96 64 0 0-96 226.7 0L384 93.3l0 66.7 64 0 0-66.7c0-17-6.7-33.3-18.7-45.3L400 18.7C388 6.7 371.7 0 354.7 0L128 0zM384 352l0 32 0 64-256 0 0-64 0-16 0-16 256 0zm64 32l32 0c17.7 0 32-14.3 32-32l0-96c0-35.3-28.7-64-64-64L64 192c-35.3 0-64 28.7-64 64l0 96c0 17.7 14.3 32 32 32l32 0 0 64c0 35.3 28.7 64 64 64l256 0c35.3 0 64-28.7 64-64l0-64zM432 248a24 24 0 1 1 0 48 24 24 0 1 1 0-48z"/></svg>
      <span>Print Semester</span>
    </button>
    <div class="academic-calendar__semester">
      <span class="academic-calendar__semester-prompt">Choose Semester:</span>
      {% if academic_calendar.prev_url %}
        <a href="{{ academic_calendar.prev_url }}" class="academic-calendar__step" rel="prev" aria-label="{{ 'Previous semester'|t }}">
          <svg class="academic-calendar__chevron" role="presentation" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 246.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z"/></svg>
        </a>
      {% else %}
        <span class="academic-calendar__step is-disabled" aria-hidden="true">
          <svg class="academic-calendar__chevron" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l192 192c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L77.3 256 246.6 86.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-192 192z"/></svg>
        </span>
      {% endif %}
      <span class="academic-calendar__semester-current">{{ academic_calendar.label }}</span>
      {% if academic_calendar.next_url %}
        <a href="{{ academic_calendar.next_url }}" class="academic-calendar__step" rel="next" aria-label="{{ 'Next semester'|t }}">
          <svg class="academic-calendar__chevron" role="presentation" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"/></svg>
        </a>
      {% else %}
        <span class="academic-calendar__step is-disabled" aria-hidden="true">
          <svg class="academic-calendar__chevron" role="presentation" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512"><path fill="currentColor" d="M310.6 233.4c12.5 12.5 12.5 32.8 0 45.3l-192 192c-12.5 12.5-32.8 12.5-45.3 0s-12.5-32.8 0-45.3L242.7 256 73.4 86.6c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0l192 192z"/></svg>
        </span>
      {% endif %}
    </div>
  </div>


  {% if rows %}
    <div class="view-content academic-calendar__list">
      {{ rows }}
    </div>
  {% elseif empty %}
    <div class="view-empty academic-calendar__empty">
      {{ empty }}
    </div>
  {% endif %}

  {% if pager %}
    {{ pager }}
  {% endif %}
</div>
