{#
/**
* @file
* Theme override to display a block.
*
* Available variables:
* - plugin_id: The ID of the block implementation.
* - label: The configured label of the block if visible.
* - configuration: A list of the block's configuration values.
*   - label: The configured label for the block.
*   - label_display: The display settings for the label.
*   - provider: The module or other provider that provided this block plugin.
*   - Block plugin specific settings will also be stored here.
* - elements: The elements of this block.
* - attributes: array of HTML attributes populated by modules, intended to
*   be added to the main container tag of this template.
*   - id: A valid HTML ID and guaranteed unique.
* - title_attributes: Same as attributes, except applied to the main title
*   tag that appears in the template.
* - title_prefix: Additional output populated by modules, intended to be
*   displayed in front of the main title tag that appears in the template.
* - title_suffix: Additional output populated by modules, intended to be
*   displayed after the main title tag that appears in the template.
*
* @see template_preprocess_block()
*/
#}
{%
  set classes = [
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if is_accordion %}
    {% set id = "accordion-" ~ id %}
    <div class="collection--accordion">
      {{ content.field_artsci_headline }}
      <div class="{{ accordion_container_classes }}" role="tablist" {% if aria_owns is not empty %}
        aria-owns="{{ aria_owns }}"
      {% endif %} aria-multiselectable="{{ multiselect }}" id="{{ id }}">
        {{ content|without('field_artsci_headline') }}
      </div>
    </div>
  {% elseif is_tab %}
    {{ attach_library('atomic_artsci/tabs') }}
    {% set tab_id = "tabs--" ~ id %}
    <div class="collection--tabs tabs-collection" id="{{ tab_id }}">
      {{ content.field_artsci_headline }}
      {# Tab navigation buttons #}
      <div role="tablist" aria-label="{{ content.field_artsci_headline|render|striptags|trim }}">
        {% for tab in tab_nav %}
          <button role="tab"
                  id="tabs--{{ tab.id }}__{{ tab.delta }}"
                  aria-controls="tabs--{{ tab.id }}__panel--{{ tab.delta }}"
                  aria-selected="{{ loop.first ? 'true' : 'false' }}"
                  {{ loop.first ? '' : 'tabindex="-1"' }}>
            {{ tab.label }}
          </button>
        {% endfor %}
      </div>
      {# Tab panels (rendered by paragraph--artsci-collection-item--tab.html.twig) #}
      {{ content|without('field_artsci_headline') }}
    </div>
  {% elseif is_dotted_line %}
    {{ attach_library('atomic_artsci/dotted-line') }}
    {% set dl_id = "dotted-line-" ~ id %}
    <div class="collection--dotted-line">
      {{ content.field_artsci_headline }}
      <div class="dotted-line" role="tablist" {% if aria_owns is not empty %}
        aria-owns="{{ aria_owns }}"
      {% endif %} aria-multiselectable="{{ multiselect }}" id="{{ dl_id }}">
        {{ content|without('field_artsci_headline') }}
      </div>
    </div>
  {% elseif is_horizontal_timeline %}
    {{ attach_library('atomic_artsci/horizontal-timeline') }}
    {% set ht_id = 'h-timeline-' ~ id %}
    {% set ht_label = content.field_artsci_headline|render|striptags|trim %}
    <div class="collection--horizontal-timeline h-timeline" id="{{ ht_id }}">
      {{ content.field_artsci_headline }}
      <div class="h-timeline__nav-wrapper">
        <button type="button" class="h-timeline__arrow h-timeline__arrow--prev" aria-label="{{ 'Previous'|t }}">
          <span aria-hidden="true">&lsaquo;</span>
        </button>
        <div class="h-timeline__rail" role="tablist" data-active-index="0" data-count="{{ h_timeline_nav|length }}"{% if ht_label %} aria-label="{{ ht_label }}"{% endif %}>
          {% for dot in h_timeline_nav %}
            <button type="button"
                    role="tab"
                    class="h-timeline__dot"
                    id="{{ ht_id }}__dot--{{ dot.delta }}"
                    aria-controls="{{ ht_id }}__panel--{{ dot.delta }}"
                    aria-selected="{{ loop.first ? 'true' : 'false' }}"
                    {{ loop.first ? '' : 'tabindex="-1"' }}>
              <span class="h-timeline__dot-label">{{ dot.label }}</span>
              <span class="h-timeline__dot-marker" aria-hidden="true"></span>
            </button>
          {% endfor %}
        </div>
        <button type="button" class="h-timeline__arrow h-timeline__arrow--next" aria-label="{{ 'Next'|t }}">
          <span aria-hidden="true">&rsaquo;</span>
        </button>
      </div>
      <div class="h-timeline__panels">
        {{ content|without('field_artsci_headline') }}
      </div>
    </div>
  {% else %}
    <div class="collection--descriptive-list">
      <dl>
        {{ content }}
      </dl>
    </div>
  {% endif %}
</div>
