{%
  set classes = [
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
]
%}

{# Extract headline classes from Layout Builder Styles #}
{% set headline_classes = [] %}
{% if elements['#layout_builder_style'] is defined %}
  {% for style in elements['#layout_builder_style'] %}
    {% if style starts with 'headline' %}
      {% set headline_classes = headline_classes|merge([style]) %}
    {% endif %}
  {% endfor %}
{% endif %}

<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}
  {% if content.field_artsci_headline|render|trim is not empty %}
    {% set banner_heading = {
      'headline_level': headline_level ?: 'h2',
      'headline_class': headline_classes,
      'headline_text': content.field_artsci_headline,
      'headline_attributes': headline_attributes ?: null,
    } %}
    {% include '@atomic_artsci/artsci/headline.html.twig' with banner_heading only %}
  {% endif %}
  {{ content|without('field_pre_title', 'field_artsci_headline') }}
</div>
