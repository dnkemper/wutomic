/**
 * Implements hook_entity_bundle_info_alter().
 */
function artsci_articles_entity_bundle_info_alter(array &$bundles) {
  if (isset($bundles['node']['article'])) {
    $bundles['node']['article']['class'] = Article::class;
  }
}

/**
 * Helper function to check if the "articles_narrow" split is enabled.
 *
 * @return bool
 *   Returns TRUE if the split is enabled, FALSE otherwise.
 */
function artsci_articles_narrow_is_enabled(): bool {
  /** @var \Drupal\Core\Config\ConfigFactoryInterface $config_factory */
  $config_factory = \Drupal::service('config.factory');
  $articles_narrow_split_config = $config_factory->get('config_split.config_split.articles_narrow');
  return ($articles_narrow_split_config->get('status') === TRUE);
}

/**
 * Implements hook_entity_extra_field_info().
 */
function artsci_articles_entity_extra_field_info() {
  $extra = [];

  $extra['node']['article'] = [
    'display' => [
      'article_created_date' => [
        'label' => t('Created Date'),
        'description' => t('Date the node was created.'),
        'weight' => 100,
        'visible' => TRUE,
      ],
    ],
  ];

  return $extra;
}

/**
 * Implements hook_form_alter().
 */
function artsci_articles_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  switch ($form_id) {
    case 'node_article_edit_form':
      $form['field_article_source_link']['widget'][0]['title']['#title'] = 'Name of Publication';
      $form['field_tags']['widget']['target_id']['#title'] = 'Category';

    case 'node_article_form':
      $form['field_article_source_link']['widget'][0]['title']['#title'] = 'Name of Publication';
      $form['field_tags']['widget']['target_id']['#title'] = 'Category';

      // If a new person is being created for the contact field,
      // they don't have a "title" yet, and so we need to fetch
      // their first and last names and combine in order to display.
      // Check that there are entities.
      if (isset($form['field_contact_reference']['widget']['entities'])) {
        $contacts = $form['field_contact_reference']['widget']['entities'];

        // For each one that exists, make sre it is one of the integer entries,
        // which is actually an entity.
        foreach ($contacts as $key => $contact) {
          if (is_int($key) && $contact['#entity']->getType() === 'person') {

            // Then, get the string of the first and last names.
            $first = $contact['#entity']?->get('field_person_first_name')?->getString();
            $last = $contact['#entity']?->get('field_person_last_name')?->getString();

            // And set the title, which would have been empty,
            // to the concatenation of the two.
            if (is_string($first) && is_string($last)) {
              $form['field_contact_reference']['widget']['entities'][$key]['#label'] = $first . ' ' . $last;
            }
          }
        }
      }
      break;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function artsci_articles_form_views_ui_edit_display_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['options']['link_url']['#description'][2]['#markup'] = ' {{ artsci_articles.path }} is the Artsci Articles path setting.';
}

/**
 * Implements hook_preprocess_HOOK().
 */
function artsci_articles_preprocess_breadcrumb(&$variables) {
  // Not ideal. Unset view contextual filter breadcrumb duplicates.
  // Waiting for https://www.drupal.org/project/drupal/issues/2966004,
  // https://www.drupal.org/project/drupal/issues/2787051...
  $routes = [];
  foreach ($variables['links'] as $key => $link) {
    $url = $link->getURL();
    // Test for external paths.
    if ($url->isRouted()) {
      $routes[$key] = $link->getUrl()->getRouteName();
    }
  }
  // For breadcrumb links built from view articles path, reduce duplicates.
  if (in_array('view.articles.page_articles', $routes)) {
    $unique_routes = array_keys(array_unique($routes, SORT_REGULAR));
    foreach ($variables['breadcrumb'] as $key => $value) {
      if (!in_array($key, $unique_routes)) {
        unset($variables['breadcrumb'][$key]);
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function artsci_articles_preprocess_field(&$variables) {
  if ($variables['element']['#field_name'] === 'field_article_author') {
    // if ($variables['element']['#formatter'] === 'string') {
    $test = $variables['element']['#formatter'] ?? 'default';
      // Expose the field's display (view mode) as a class on the wrapper,
      // e.g. field--display-default, field--display-header-image.
      $variables['attributes']['class'][] = 'field--display-' . $test;
      if ($test === 'entity_reference_entity_view') {
        $variables['element']['#title'] = 'About the author';
        $variables['label'] = 'About the author';
      }
      else {
        $variables['element']['#title'] = 'By';
        $variables['label'] = 'By';
      }
  }
  if ($variables['element']['#field_name'] === 'field_tags') {
    // if ($variables['element']['#view_mode'] == 'teaser') {
    //   artsci_core_set_field_icon($variables, 'fas fa-tags');
    // }
    if ($variables['element']['#formatter'] === 'entity_reference_label') {
      $variables['element']['#title'] = 'Topics';
      $variables['label'] = 'Topics';
      // Remove the label for article teasers.
      if ($variables['element']['#view_mode'] == 'teaser') {
        artsci_core_set_title_attributes($variables, 'visually-hidden');
        artsci_core_set_attributes($variables, 'field--label-visually_hidden');
      }
    }
    // Loop through all author fields in the byline and add credentials
    // (if available) to their names.
    foreach ($variables['items'] as $key => $item) {
      $author_entity = $item['content']['#options']['entity'];
      $credentials = $author_entity
        ?->field_person_credential
        ?->value;

      if (!is_null($credentials)) {
        $variables['items'][$key]['content']['#title'] .= ', ' . $credentials;
      }
    }
  }
  if ($variables['element']['#field_name'] === 'field_article_source_org') {
    if ($variables['element']['#formatter'] === 'string') {
      $variables['element']['#title'] = 'By';
      $variables['label'] = 'By';
    }
  }
  if ($variables['element']['#field_name'] === 'field_gallery_images') {
    if ($variables['element']['#bundle'] === 'article') {
      $variables['label_tag'] = 'h2';
      $variables['field_container_classes'] = 'artsci-image-gallery';
      artsci_core_set_title_attributes($variables, [
        'block__headline',
        'headline',
        'headline--serif',
        'headline--underline',
      ]);
    }
  }
  if ($variables['element']['#field_name'] === 'field_article_source_link') {
    if ($variables['element']['#formatter'] === 'link') {
      $variables['element']['#title'] = 'Source';
      $variables['label'] = 'Source';
    }
  }
  if ($variables['element']['#field_name'] === 'field_image_caption') {
    $variables['attributes']['class'][] = 'figure-caption';
    $variables['attributes']['id'] = 'node-caption';
  }
  if ($variables['element']['#field_name'] === 'field_image') {
    $node = $variables['element']['#object'];
    if ($node->hasField('field_image_caption') && !$node->get('field_image_caption')->isEmpty()) {
      $variables['attributes']['aria-describedby'] = 'node-caption';
    }
  }
  if ($variables['element']['#field_name'] === 'field_related_content') {
    $variables['attributes']['class'][] = 'list-container--grid';
    $variables['attributes']['class'][] = 'grid--threecol--33-34-33';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function artsci_articles_theme_suggestions_field_alter(array &$suggestions, array $variables) {
  if ($variables['element']['#field_name'] === 'field_tags') {
    if ($variables['element']['#formatter'] === 'entity_reference_label') {
      $suggestions[] = 'field__node__field_tags__sep';
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function artsci_articles_preprocess_page(&$variables) {
  $current_route = \Drupal::routeMatch();
  $route_name = $current_route->getRouteName();
  if ($route_name === 'view.articles.page_articles') {
    // Get the current user.
    $user = \Drupal::currentUser();
    // Check for permission.
    if ($user->hasPermission('administer artsci articles') === TRUE) {
      // Print warning message informing user to use basic site settings.
      $url = Url::fromRoute('artsci_articles.settings_form');
      $settings_link = Link::fromTextAndUrl(t('Artsci Articles'), $url)
        ->toString();
      $message_text = t('This page can be configured here: @settings_link', [
        '@settings_link' => $settings_link,
      ]);
      \Drupal::messenger()->addStatus($message_text);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function artsci_articles_preprocess_node(&$variables) {
  $admin_context = \Drupal::service('router.admin_context');
  if (!$admin_context->isAdminRoute()) {

    $node = $variables['node'];

    switch ($node->getType()) {
      case 'article':
        // $variables['content']['article_author'] = $node->field_tags->view([
        //   'type' => 'entity_reference_label',
        //   'label' => 'inline',
        //   'settings' => [],
        // ]);

        switch ($variables['view_mode']) {
          case 'full':
          case 'default':
            // For now, different byline behavior on full node than on teaser.
            // if (!$node->get('field_article_source_link')->isEmpty()) {
            //   $variables['content']['field_article_source_link'][0]['#title'] = $node->field_article_source_org->value;
            //   unset($variables['content']['field_article_source_org']);
            // }

            // Check if we don't have any gallery images.
            if ($node->hasField('field_gallery_images') &&
              empty($node->get('field_gallery_images')->getValue())) {
              // If no gallery images, then hide the gallery jumplink.
              artsci_core_unset_layout_builder_block($variables, 'galleryjumplink_block');
            }

            break;

        }
        break;

      case 'person':

        switch ($variables['view_mode']) {
          case 'full':
          case 'default':
            $person_display_config = \Drupal::config('artsci_articles.settings')->get('display_articles_by_author');

            if (!$person_display_config) {
              artsci_core_unset_layout_builder_block($variables, 'views_block:articles_author-articles_author');
            }

            break;

        }
        break;

    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function artsci_articles_node_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  switch ($entity->getType()) {
    case 'article':
      if ($display->getComponent('article_created_date')) {
        $created = $entity->get('created')->value;
        $date = \Drupal::service('date.formatter')->format($created, 'article');
        $build['article_created_date'] = [
          '#type' => 'container',
          '#attributes' => [
            'class' => ['article-created-date'],
          ],
          'date' => [
            '#type' => 'markup',
            '#markup' => $date,
            '#weight' => 0,
          ],
        ];

        if ($view_mode !== 'teaser' && artsci_articles_narrow_is_enabled()) {
          $build['article_created_date']['title'] = [
            '#type' => 'html_tag',
            '#tag' => 'div',
            '#value' => t('Published:'),
            '#attributes' => [
              'class' => ['field__label'],
            ],
            '#weight' => -10,
          ];
        }
      }

      break;

  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function artsci_articles_preprocess_views_view(&$variables) {
  switch ($variables['id']) {
    case 'articles':
      $variables['#attached']['library'][] = 'atomic_artsci/view-articles-list';

      /** @var  \Drupal\views\ViewExecutable $view */
      $view = $variables['view'];

      if (empty($variables['header']['area']['#text'])) {
        unset($variables['header']['area']);
      }

      // If this is the page display and arguments were provided, hide the
      // feed icons since we don't want to promote those filtered RSS feeds.
      if ($view->current_display === 'page_articles' && !empty($view->args)) {
        $variables['feed_icons'] = [];
      }

      break;

    case 'article_list_block':
    case 'rss_block':
      $variables['#attached']['library'][] = 'atomic_artsci/view-articles-list';
      break;

  }
}

/**
 * Implements hook_preprocess_views_view_summary().
 */
function artsci_articles_preprocess_views_view_summary(&$variables) {
  if ($variables['view']->current_display === 'block_articles_archive') {
    foreach ($variables['rows'] as $row) {
      $explode = explode('/', $row->url);
      unset($explode[3]);
      $explode[2] = substr_replace($explode[2], '/', 4, 0);
      $row->url = implode("/", $explode);
    }
  }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function artsci_articles_preprocess_views_view_unformatted(&$variables) {
  $view = $variables['view'];

  // Style stacked if from related_manually_referenced_content block grid,
  // otherwise media right. Unset completely for Artsci v2.
  if ($view->id() === 'related_manually_referenced_content' && $view->current_display === 'block_grid') {

      foreach ($variables['rows'] as &$row_build) {
        $row_build['content']['#override_styles'] = [
          'card_media_position' => 'card--stacked',
          'bg' => 'bg--white',
          'media_format' => 'media--widescreen',
          'media_size' => 'media--large',
          'hide_descriptions' => 'hide-descriptions',
        ];
      }
  }

  $variables['row_item_classes'] = [];

  switch ($view->current_display) {
    case 'articles_author':
      artsci_core_views_row_hide_fields($variables, 'field_tags', 'field_teaser', 'field_image', 'field_article_source_org', 'field_article_source_link');
      break;
  }
}

/**
 * Implements hook_uip_classes_alter().
 */
function artsci_articles_uip_classes_alter(&$options, $entity, $bundle) {
  switch ($bundle) {
    case 'articles':
      $options['hide-descriptions'] = 'Hide Summaries';
      $options['hide-images'] = 'Hide Images';
      $options['grid'] = 'Grid';
      $options['masonry'] = 'Masonry';
      break;

  }
}

/**
 * Implements hook_theme().
 */
function artsci_articles_theme($existing, $type, $theme, $path) {
  return [
    'paragraph__articles__default' => [
      'template' => 'paragraph--articles--default',
      'base hook' => 'paragraph',
    ],
  ];
}


/**
 * Implements hook_views_pre_render().
 */
function artsci_articles_views_pre_render(ViewExecutable $view) {
  // Add replacement token for articles page path.
  $view->build_info['substitutions']['{{ artsci_articles.path }}'] = _artsci_articles_path_token_value();
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function artsci_articles_form_views_exposed_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if ($view->id() === 'articles_block') {
    if ($view->current_display === 'block_articles') {
      $exposed_input = $view->getExposedInput();
      if (isset($exposed_input["items_per_page"])) {
        $form["items_per_page"]["#options"] = [$exposed_input["items_per_page"] => $exposed_input["items_per_page"]];
        $form["#attributes"]["class"][] = 'hidden';
      }
    }
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function artsci_articles_inline_entity_form_table_fields_alter(array &$fields, array $context) {
  if ($context['field_name'] === 'field_contact_reference') {
    // Clean up, minimize the person IEF form.
    if (in_array('person', $context['allowed_bundles'])) {
      $fields['label']['label'] = t('Contact name');
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function artsci_articles_preprocess_block(&$variables) {
  switch ($variables['elements']['#plugin_id']) {

    case 'field_block:node:article:field_gallery_images':
      $variables['attributes']['class'][] = 'media--square';
      break;

    case 'field_block:node:article:field_tags':
    case 'field_block:node:article:field_article_source_link':
    case 'field_block:node:article:field_article_source_org':
    case 'galleryjumplink_block':
    case 'field_block:node:article:field_image_caption':
      $variables['attributes']['class'][] = 'article--meta';

      break;

    case 'field_block:node:article:field_article_subhead':
      $variables['attributes']['class'][] = 'artsci-component--bold-intro';
      $variables['attributes']['class'][] = 'block-margin__top--extra';

      break;

    case 'field_block:node:article:field_contact_reference':
      $variables['attributes']['class'][] = 'article--meta article--meta__block';

      break;

    case 'field_block:node:article:body':
      if (artsci_articles_narrow_is_enabled()) {
        $variables['attributes']['class'][] = 'block-margin__default--removed';
      }

      break;
  }
}

/**
 * Implements hook_token_info().
 */
function artsci_articles_token_info(): array {
  $info = [];
  $info['types']['artsci_articles'] = [
    'name' => t('Artsci Articles'),
    'description' => t('Tokens for Artsci Articles.'),
  ];
  $info['tokens']['artsci_articles']['path'] = [
    'name' => 'Artsci Articles path',
    'description' => 'A token to display the Artsci Articles page path.',
  ];
  return $info;
}

/**
 * Implements hook_tokens().
 */
function artsci_articles_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata) {
  $replacements = [];
  if ($type === 'artsci_articles') {

    foreach ($tokens as $name => $original) {
      // Find the desired token by name.
      switch ($name) {
        case 'artsci_articles_path':
          $replacements[$original] = _artsci_articles_path_token_value();
          break;
      }
    }
  }
  return $replacements;
}

/**
 * Callback to get the Artsci Articles view path.
 *
 * @todo Revisit how this is constructed.
 * https://github.com/artsci/artsci/issues/6286
 */
function _artsci_articles_path_token_value() {

  // Load articles listing view.
  $view = Drupal::entityTypeManager()->getStorage('view')->load('articles');

  // Loop through displays except Master.
  $displays = $view->get('display');
  unset($displays['default']);
  foreach ($displays as $display_id => $display) {
    // If page display is not enabled, skip.
    if ($display_id !== 'page_articles') {
      continue;
    }

    // @todo Do we need to do anything besides this?
    return '/' . $display['display_options']['path'];
  }

  // @todo Is this appropriate when there is no value?
  return '';
}

/**
 * Implements hook_entity_field_access().
 *
 * Hides the plain-text "Author Name" (field_article_source_org) on articles
 * whenever the structured "Article Authors" reference (field_article_author)
 * has at least one value. The two fields are alternative representations of
 * the same byline; when the structured reference is populated it is the
 * canonical one, so the free-text org is suppressed to avoid a duplicate
 * byline.
 *
 * Denying 'view' access here (rather than unsetting in a node preprocess) is
 * the Layout Builder-correct approach: the article display renders these
 * fields as Layout Builder field blocks, and FieldBlock::blockAccess()
 * consults field access, so a forbidden result suppresses the whole block
 * with no empty wrapper or label left behind. It also applies consistently
 * to the teaser and any other rendering of the field.
 *
 * The result is made cache-dependent on the entity so that adding or removing
 * an Article Authors value re-evaluates source-org visibility.
 */
function artsci_articles_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($operation !== 'view' || $field_definition->getName() !== 'field_article_source_org') {
    return AccessResult::neutral();
  }

  // Field access can be evaluated without a specific entity (e.g. in the
  // Field UI); with no items there is no sibling field to consult.
  if ($items === NULL) {
    return AccessResult::neutral();
  }

  $entity = $items->getEntity();
  if ($entity->bundle() !== 'article' || !$entity->hasField('field_article_author')) {
    return AccessResult::neutral();
  }

  // Forbid the free-text org only when the structured author reference is
  // populated; otherwise stay neutral so normal access rules apply.
  $access = $entity->get('field_article_author')->isEmpty()
    ? AccessResult::neutral()
    : AccessResult::forbidden();

  return $access->addCacheableDependency($entity);
}
