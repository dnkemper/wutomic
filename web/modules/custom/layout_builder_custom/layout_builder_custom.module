/**
 * Implements hook_theme().
 */
function layout_builder_custom_theme() {
  return [
    'oembed_thumbnail' => [
      'variables' => [
        'thumbnail_url' => NULL,
        'thumbnail_fallback_url' => NULL,
        'video_url' => NULL,
        'iframe_url' => NULL,
        'max_width' => 0,
        'max_height' => 0,
        'autoplay' => FALSE,
        'media_entity' => NULL,
      ],
    ],
    // 'artsci_headline_field_type' => [
    //   'variables' => [
    //     'pre_headline' => NULL,
    //     'text' => NULL,
    //     'size' => 'h2',
    //     'styles' => '',
    //     'alignment' => 'headline--left',
    //   ],
    // ],
  ];
}

/**
 * Preprocess function for artsci_headline_field_type.
 */
// function template_preprocess_artsci_headline_field_type(&$variables) {
//   // Variables are passed directly from the formatter.
//   // The template handles the rendering logic.
// }

/**
 * Implements hook_element_info_alter().
 */
function layout_builder_custom_element_info_alter(array &$types) {
  $types['layout_builder']['#pre_render'][] = LayoutBuilderPreRender::class . '::preRender';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function layout_builder_custom_form_layout_builder_configure_section_alter(&$form, FormStateInterface $form_state, $form_id) {
  $formObject = $form_state->getFormObject();
  /** @var \Drupal\Core\Layout\LayoutInterface $layout */
  $layout = $formObject->getLayout();
  $config = $layout->getConfiguration();
  // Section component unique ID is stored in third-party settings.
  $wrapper_id = Html::getUniqueId('unique-id-wrapper');
  $form['unique_id'] = [
    '#prefix' => '<div id="' . $wrapper_id . '">',
    '#suffix' => '</div>',
    '#type' => 'textfield',
    '#title' => t('Unique ID'),
    '#description' => t('Provide a unique identifier for this section. Primarily used for anchor links. Input will be cleaned to convert spaces and remove special characters.'),
    '#default_value' => $config['layout_builder_custom_unique_id'] ?: '',
    '#ajax' => [
      'callback' => '_layout_builder_custom_unique_id',
      'wrapper' => $wrapper_id,
      'disable-refocus' => TRUE,
    ],
  ];
  // Section headline fields.
  $headline_config = $config['layout_builder_custom_headline'] ?? [];
  $form['section_headline'] = [
    '#type' => 'details',
    '#title' => t('Section headline'),
    '#tree' => TRUE,
    '#weight' => -10,
    '#open' => !empty($headline_config['headline']),
  ];
  $form['section_headline']['pre_headline'] = [
    '#type' => 'textfield',
    '#title' => t('Pre-headline'),
    '#default_value' => $headline_config['pre_headline'] ?? '',
  ];
  $form['section_headline']['headline'] = [
    '#type' => 'textfield',
    '#title' => t('Headline'),
    '#default_value' => $headline_config['headline'] ?? '',
  ];
  $form['section_headline']['hide_headline'] = [
    '#type' => 'checkbox',
    '#title' => t('Visually hide title'),
    '#default_value' => $headline_config['hide_headline'] ?? 0,
    '#states' => [
      'visible' => [
        ':input[name="section_headline[headline]"]' => ['filled' => TRUE],
      ],
    ],
  ];
  $form['section_headline']['heading_size'] = [
    '#type' => 'select',
    '#title' => t('Headline size'),
    '#options' => HeadlineHelper::getHeadingOptions(),
    '#default_value' => $headline_config['heading_size'] ?? 'h2',
    '#states' => [
      'visible' => [
        ':input[name="section_headline[headline]"]' => ['filled' => TRUE],
      ],
    ],
  ];
  $form['section_headline']['headline_style'] = [
    '#type' => 'select',
    '#title' => t('Headline style'),
    '#options' => [
      'default' => t('Default'),
      'headline_bold_serif_red' => t('Bold serif, red text'),
      'headline_bold_serif_underline' => t('Bold serif, underlined'),
    ],
    '#default_value' => $headline_config['headline_style'] ?? 'default',
    '#states' => [
      'visible' => [
        ':input[name="section_headline[headline]"]' => ['filled' => TRUE],
      ],
    ],
  ];
  $form['section_headline']['headline_alignment'] = [
    '#type' => 'select',
    '#title' => t('Headline alignment'),
    '#options' => [
      'default' => t('Left (default)'),
      'headline_alignment_center' => t('Center'),
    ],
    '#default_value' => $headline_config['headline_alignment'] ?? 'default',
    '#states' => [
      'visible' => [
        ':input[name="section_headline[headline]"]' => ['filled' => TRUE],
      ],
    ],
  ];
  // Add custom validation for section form.
  $form['#validate'][] = '_layout_builder_custom_section_form_validate';

  // Our submit handler must execute before the default one, because the
  // default handler stores the section & component data in the tempstore
  // and we need to update those objects before that happens.
  array_unshift($form['#submit'], '_layout_builder_custom_submit_section_form');
}

/**
 * Custom validation for layout_builder_add/update_block form.
 *
 * @param array $form
 *   The form element.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function _layout_builder_custom_section_form_validate(array &$form, FormStateInterface $form_state) {
  // Run unique_id clean for when the AJAX callback is not triggered.
  if ($unique_id = $form_state->getValue('unique_id')) {
    $form_state->setValue('unique_id', Html::cleanCssIdentifier($unique_id));
  }
}

/**
 * Custom submit handler for layout builder section configure form.
 *
 * @param array $form
 *   The form element.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function _layout_builder_custom_submit_section_form(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\layout_builder_styles\Form\ConfigureSectionForm $formObject */
  $formObject = $form_state->getFormObject();
  $config = $formObject->getLayout()->getConfiguration();
  if (!$config) {
    $config = [];
  }

  // Save the third-party value if set, otherwise unset it.
  if ($unique_id = $form_state->getValue('unique_id')) {
    $config['layout_builder_custom_unique_id'] = $unique_id;
  }
  else {
    unset($config['layout_builder_custom_unique_id']);
  }
  $headline_values = $form_state->getValue('section_headline');
  if (!empty($headline_values['headline']) || !empty($headline_values['pre_headline'])) {
    $config['layout_builder_custom_headline'] = [
      'pre_headline' => $headline_values['pre_headline'] ?? '',
      'headline' => $headline_values['headline'],
      'hide_headline' => $headline_values['hide_headline'] ?? 0,
      'heading_size' => $headline_values['heading_size'] ?? 'h2',
      'headline_style' => $headline_values['headline_style'] ?? 'default',
      'headline_alignment' => $headline_values['headline_alignment'] ?? 'default',
    ];
  }
  else {
    unset($config['layout_builder_custom_headline']);
  }
  $formObject
    ->getLayout()
    ->setConfiguration($config);
}

/**
 * Implements hook_form_alter().
 */
function layout_builder_custom_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  switch ($form_id) {
    case 'layout_builder_add_block':
    case 'layout_builder_update_block':
      // Add custom validation for certain blocks/regions to validate.
      $form['#validate'][] = '_layout_builder_custom_block_validate';

      // Our submit handler must execute before the layout_builder_styles one
      // so it can take advantage of the logic there.
      array_unshift($form['#submit'], '_layout_builder_custom_block_submit');

      if (isset($form['settings'])) {
        // Add custom process callback for certain blocks to alter elements.
        $form['settings']['block_form']['#process'][] = '_layout_builder_custom_process_element';
      }

      // @todo Write a patch for layout_builder_styles that adds these options. See
      //   https://github.com/artsci/artsci/issues/5010
      // An array of options for altering Layout Builder Styles behavior.
      $lb_styles_extra_settings = LayoutBuilderStylesHelper::getExtraSettings();

      // Always set title field to not be required.
      $form['settings']['label']['#required'] = FALSE;

      // Hide all block labels.
      unset($form['settings']['label']);
      unset($form['settings']['label_display']);
      unset($form['settings']['admin_label']['#title']);

      // Move the admin label up for all blocks.
      if (isset($form['settings']['admin_label'])) {
        $form['settings']['admin_label']['#weight'] = -100;
      }

      // Hide ones implemented by Views because ListBlock has headline.
      // @todo Investigate whether this can be added to ListBlock. See
      //   https://github.com/artsci/artsci/issues/5035
      unset($form['settings']['views_label_fieldset']);
      unset($form['settings']['views_label_checkbox']);
      unset($form['settings']['views_label']);

      if (isset($form['layout_builder_style_list_format'])) {
        // Set '#states' for block grid columns.
        $form['layout_builder_style_media_format']['#states'] = [
          'visible' => [
            // Always show when list format is grid.
            [
              ':input[name="layout_builder_style_list_format"]' => [
                'value' => 'list_format_grid',
              ],
            ],
          ],
        ];
        $form['layout_builder_style_media_size']['#states'] = [
          'visible' => [
            // Always show when list format is grid.
            [
              ':input[name="layout_builder_style_list_format"]' => [
                'value' => 'list_format_grid',
              ],
            ],
          ],
        ];
        $form['layout_builder_style_card_media_position']['#states'] = [
          'visible' => [
            // Always show when list format is grid.
            [
              ':input[name="layout_builder_style_list_format"]' => [
                'value' => 'list_format_grid',
              ],
            ],
          ],
        ];
      }
      $form_object = $form_state->getFormObject();
      if ($form_object instanceof ConfigureBlockFormBase) {
        /** @var \Drupal\layout_builder\SectionComponent $component */
        $component = $form_object->getCurrentComponent();
        $block = $component->getPlugin();

        // Add heading before style options, but not for banner.
        if ($block->getPluginId() !== 'inline_block:artsci_banner') {
          _layout_builder_custom_add_lbs_heading($form);
        }

        // Section component unique ID is stored in third-party settings.
        $wrapper_id = Html::getUniqueId('unique-id-wrapper');
        $form['unique_id'] = [
          '#prefix' => '<div id="' . $wrapper_id . '">',
          '#suffix' => '</div>',
          '#type' => 'textfield',
          '#title' => t('Unique ID'),
          '#description' => t('Provide a unique identifier for this block. Primarily used for anchor links. Input will be cleaned to convert spaces and remove special characters.'),
          '#default_value' => $component->getThirdPartySetting('layout_builder_custom', 'unique_id'),
          '#weight' => -52,
          '#ajax' => [
            'callback' => '_layout_builder_custom_unique_id',
            'wrapper' => $wrapper_id,
            'disable-refocus' => TRUE,
          ],
        ];

        // Modifications to $lb_styles_extra_settings based on block plugin.
        switch ($block->getPluginId()) {
          case 'inline_block:artsci_card':
            $form['#attached']['library'][] = 'layout_builder_custom/card-block-form';
            $form['layout_builder_style_card_media_position']['#description'] = t('<a target="_blank" href="https://artsci.washu.edu/documentation/layout-builder/card-block">The media position will change based on the width of the layout column.</a>');
            
            // Hide margin field - will default to block_margin_default_removed.
            if (isset($form['layout_builder_style_margin'])) {
              $form['layout_builder_style_margin']['#access'] = FALSE;
            }
            
            // Hide default/card style field - will default to card_style_button_position.
            if (isset($form['layout_builder_style_default'])) {
              $form['layout_builder_style_default']['#access'] = FALSE;
            }
              if (isset($form['button_group']['layout_builder_style_button_style'])) {
                $form['button_group']['layout_builder_style_button_style']['#states'] = [
                  'visible' => [
                    ':input[name="settings[block_form][field_artsci_card_link][0][uri]"]' => ['filled' => TRUE],
                  ],
                ];
              }

              if (isset($form['button_group']['layout_builder_style_button_font_duplicate'])) {
                $form['button_group']['layout_builder_style_button_font_duplicate']['#states'] = [
                  'visible' => [
                    ':input[name="settings[block_form][field_artsci_card_link][0][uri]"]' => ['filled' => TRUE],
                  ],
                ];
              }
            break;
            
            case 'inline_block:artsci_image_gallery':
              $form['#attached']['library'][] = 'layout_builder_custom/image-block-form';
              $lb_styles_extra_settings['media_format']['default'] = 'media_format_square';
              break;

          // Media left, media circle, and no border are the defaults.
          case 'inline_block:artsci_aggregator':
          case 'views_block:events-card_list':
          case 'views_block:article_list_block-list_article':
          case 'views_block:article_list_block-list_article_recent':
          case 'views_block:image_card_list_block-list_image_card':
          case 'views_block:people_list_block-list_card':
            $lb_styles_extra_settings['card_media_position']['default'] = 'card_media_position_stacked';
            $lb_styles_extra_settings['media_format']['default'] = 'media_format_widescreen';
            $lb_styles_extra_settings['border']['default'] = 'no_border';
            break;
          
          case 'inline_block:featured_content':
            // Hide list format field - will default to grid.
            // if (isset($form['layout_builder_style_list_format'])) {
            //   $form['layout_builder_style_list_format']['#access'] = FALSE;
            // }
            // Hide margin field - will default to block_margin_default_removed.
            if (isset($form['layout_builder_style_margin'])) {
              $form['layout_builder_style_margin']['#access'] = FALSE;
            }
            break;
        }

        // Loop through map of default styles and append text indicating
        // that they are the defaults if appropriate.
        // This ensures duplicates inherit
        // the correct defaults when they're created.
        foreach ($lb_styles_extra_settings as $key => $settings) {
          // The key that is used in the form array.
          $key = 'layout_builder_style_' . $key;
          // If the style group is set...
          if (isset($form[$key])) {
            if (isset($settings['default'])) {
              // If an alternative label has been added for the empty option,
              // use it instead.
              if (isset($settings['empty_label']) && isset($form[$key]['#empty_option'])) {
                $form[$key]['#empty_option'] = t('@label', [
                  '@label' => $settings['empty_label'],
                ]);
              }

              // If the default option is exists, add the text there.
              if (isset($form[$key]['#options'][$settings['default']])) {
                $form[$key]['#options'][$settings['default']] .= ' (default)';
              }
              // Otherwise, if the empty option should be the default, add
              // the text there.
              elseif ($settings['default'] === '[empty]' && isset($settings['empty_label']) && $form[$key]['#empty_option'] instanceof TranslatableMarkup) {
                $form[$key]['#empty_option'] = t('@empty_option (default)', [
                  '@empty_option' => $form[$key]['#empty_option']->render(),
                ], $form[$key]['#empty_option']->getOptions());
              }
            }

            // Set layout builder style default settings.
            if ($form_id === 'layout_builder_add_block' && $settings['default'] !== '[empty]') {
              // Check if this is a radio button group.
              if (isset($form[$key]['#type']) && $form[$key]['#type'] === 'radios') {
                // Radio buttons need a scalar value.
                $form[$key]['#default_value'] = $settings['default'];
              }
              else {
                // Checkboxes and other multi-select elements expect an array.
                $form[$key]['#default_value'] = [$settings['default']];
              }
            }
          }
        }

        // Form modifications per block plugin and bundle.
        switch ($block->getPluginId()) {
          case 'inline_block:artsci_banner':
            BannerBlockFormHandler::formAlter($form, $form_state, $form_id);
            break;

          case 'inline_block:artsci_card':
            CardBlockFormHandler::formAlter($form, $form_state, $form_id);
            break;

          case 'inline_block:artsci_slider':
            unset($form['layout_builder_style_artsci_carousel_size']['#empty_option']);
            SliderBlockFormHandler::formAlter($form, $form_state, $form_id);
            break;

          case 'inline_block:artsci_text_area':
          case 'webform_block':
            $form['layout_builder_style_padding']['#empty_option'] = 'None';
            break;

          case 'inline_block:artsci_aggregator':
          case 'inline_block:artsci_events':
          case 'views_block:article_list_block-list_article':
          case 'views_block:article_list_block-list_article_recent':
          case 'views_block:article_list_block-list_book':
          case 'views_block:article_list_block-list_event':
          case 'views_block:article_list_block-list_person':
          case 'views_block:events-card_list':
          case 'views_block:page_list_block-list_page':
          case 'views_block:image_card_list_block-list_image_card':
          case 'views_block:people_list_block-list_card':
            // Set help text for media position.
            $form['layout_builder_style_card_media_position']['#description'] = t('<a target="_blank" href="https://artsci.washu.edu/documentation/layout-builder/content-lists">The media position will change based on the width of the layout column.</a>');

            // Listblock specific default.
            if ($form_id === 'layout_builder_add_block') {
              if ($form['settings']['override']['items_per_page']) {
                $form['settings']['override']['items_per_page']['#default_value'] = 10;
              }
            }

            if ($form_id === 'layout_builder_add_block' || $form_id === 'layout_builder_update_block') {
              switch ($block->getPluginId()) {
                case 'views_block:events_list_block-card_list':
                  // $form['settings']['exposed']['filter-field_event_when_value']['field_event_when_value']['#type'] = 'hidden';
                  break;

                case 'views_block:people_list_block-list_card':
                  // Don't allow the person type status filter to be exposed.
                  $form['settings']['exposed']['filter-field_person_type_status_value']['exposed']['#type'] = 'hidden';
                  break;
              }
            }

            // Make some block-specific add form adjustments.
            if ($form_id === 'layout_builder_add_block') {
              switch ($block->getPluginId()) {
                case 'views_block:article_list_block-list_article':
                case 'views_block:article_list_block-list_article_recent':
                  $form['settings']['override']['hide_fields']['order_fields']['field_article_source_link']['hide']['#default_value'] = 1;
                  break;

                case 'views_block:people_list_block-list_card':
                  $form['settings']['override']['hide_fields']['order_fields']['field_person_website']['hide']['#default_value'] = 1;
                  break;
              }
            }

            break;

          case 'inline_block:artsci_collection':
            $form['settings']['view_mode']['#type'] = 'radios';

            // We need to have a specified view mode,
            // so we remove the undefined 'default' option.
            array_shift($form['settings']['view_mode']['#options']);

            // @todo Re-enable 'tab' after theming/functionality is in place. See
            //   https://github.com/artsci/artsci/issues/5011
            // unset($form['settings']['view_mode']['#options']['tab']);

            $view_options = [
              'accordion',
              'dotted_line',
              'horizontal_timeline',
              'tab',
            ];

            // If view mode not in our options (eg 'full'), set it to <dl>.
            if (!in_array($form['settings']['view_mode']['#default_value'], $view_options)) {
              $form['settings']['view_mode']['#default_value'] = 'accordion';
            }

            // Move view mode to the block form.
            $form['settings']['block_form']['view_mode'] = $form['settings']['view_mode'];
            $form['settings']['view_mode']['#access'] = FALSE;
            break;

          case 'menu_block:main':
            // If the menu_orientation style group is present...
            if (isset($form['layout_builder_style_menu_orientation'])) {

              // Move the layout_builder_style_menu_orientation into settings so
              // it can be placed below the admin label.
              $form['settings']['layout_builder_style_menu_orientation'] = [
                '#weight' => -10,
                  // We set the #tree to FALSE because this value
                  // will override the original in the form state.
                '#tree' => FALSE,
                '#description' => t('The "Horizontal" option will look the same as the "Vertical" option if this block is being placed in something other than a one column layout.'),
              ] + $form['layout_builder_style_menu_orientation'];

              // To get the style to process correctly, we need to leave it here
              // but make it inaccessible.
              $form['layout_builder_style_menu_orientation']['#access'] = FALSE;

              // Add #states to only show fixed parent
              // if follow active menu item is unchecked.
              $form['settings']['advanced']['parent']['#states'] = [
                'visible' => [
                  ':input[name="settings[follow]"]' => [
                    'checked' => FALSE,
                  ],
                ],
              ];

              // Add #states to level field to hide menu levels
              // if follow active menu item is unchecked.
              $form['settings']['menu_levels']['level']['#states'] = [
                'visible' => [
                  ':input[name="settings[follow]"]' => [
                    'checked' => FALSE,
                  ],
                ],
              ];

              // Set '#states' for menu alignment.
              $form['layout_builder_style_alignment']['#states'] = [
                'visible' => [
                  // Always show alignment options if orientation.
                  // is set to 'horizontal'.
                  [
                    ':input[name="layout_builder_style_menu_orientation"]' => [
                      'value' => 'block_menu_horizontal',
                    ],
                  ],
                ],
              ];

              // Unset the layout builder style heading.
              unset($form['lbs_heading']);
            }

            // Adjustments to advanced settings.
            // Adjust name advanced options section.
            $form['settings']['advanced']['#title'] = t('Visibility options');
            // Move the advanced settings to be the first section.
            $form['settings']['advanced']['#weight'] = -5;
            // Append 'Menu' to the end of the admin label for clarity.
            $form['settings']['admin_label']['#plain_text'] .= ' Menu';
            // Unset the menu option in the label.
            unset($form['settings']['advanced']['label_type']['#options']['menu']);
            // Hide this option until menu_block fixes initialization of menuRoot.
            // Fix is being tracked in https://github.com/artsci/artsci/issues/9647.
            unset($form['settings']['advanced']['label_type']['#options']['visibility_level_parent']);
            // Default existing blocks off unsupported label type.
            if (($form['settings']['advanced']['label_type']['#default_value'] ?? NULL) === 'visibility_level_parent') {
              $form['settings']['advanced']['label_type']['#default_value'] = 'block';
            }
            // Adjust the default text.
            $form['settings']['advanced']['label_type']['#options']['block'] = t('"Section Menu" (default)');
            // Update the description on the label_type.
            $form['settings']['advanced']['label_type']['#description'] = t('Replace the block title with an item from the menu. The title is displayed only for screen reader users. In addition, this will set the label for the mobile menu toggle on the Horizontal orientation.');
            // Hide the options to set the parent to render.
            $form['settings']['advanced']['render_parent']['#access'] = FALSE;
            // Hide the options to hide on nonactive menu pages.
            $form['settings']['advanced']['hide_on_nonactive']['#access'] = FALSE;
            // Hide the options to set the block link.
            $form['settings']['advanced']['label_link']['#access'] = FALSE;
            // Hide the option to display empty block.
            $form['settings']['advanced']['display_empty']['#access'] = FALSE;
            // Append to the fixed parent description to indicate that initial
            // visibility level should be set to 1 if used.
            /** @var \Drupal\Core\StringTranslation\TranslatableMarkup $parent_description */
            $parent_description = $form['settings']['advanced']['parent']['#description'];
            $form['settings']['advanced']['parent']['#description'] = t('@parent_description_text Make sure that "Initial visibility level" is set to "1" below.', array_merge(
              [
                '@parent_description_text' => $parent_description->getUntranslatedString(),
              ],
              $parent_description->getArguments()));
            // Unset the advanced description since it refers to
            // functionality that we are not offering.
            unset($form['settings']['advanced']['follow']['#description']);
            // Move the advanced follow setting to the front of its section.
            $form['settings']['advanced']['follow']['#weight'] = -20;

            // Adjustments to menu level settings.
            // Limit the depth options to 1-3.
            foreach ($form['settings']['menu_levels']['depth']['#options'] as $key => $depth) {
              if ($key < 1 || $key > 3) {
                unset($form['settings']['menu_levels']['depth']['#options'][$key]);
              }
            }
            // Hide the make the ability to force expand all items.
            $form['settings']['menu_levels']['expand_all_items']['#access'] = FALSE;

            // Hide the HTML and style options.
            $form['settings']['style']['#access'] = FALSE;

            // If the block is being added, default the advanced follow value to
            // TRUE.
            if ($form_id === 'layout_builder_add_block') {
              $form['settings']['advanced']['follow']['#default_value'] = TRUE;
            }

            break;

        }
      }

      $form['settings'] += [
        '#weight' => 0,
      ];

      break;

    case 'layout_builder_configure_section':
      // Remove container settings - None - empty option.
      unset($form['layout_builder_style_container']['#empty_option']);
      unset($form['layout_builder_style_container_duplicate']['#empty_option']);
      if (isset($form['layout_builder_style_container'])) {
        // Add (Default) after Normal option.
        $form['layout_builder_style_container']['#options']['section_margin_fixed_width_container'] = 'Normal (Default)';

        if (isset($form['#attributes']['data-layout-builder-target-highlight-id'])) {

          $match = 'section-update';
          $is_update = substr($form['#attributes']['data-layout-builder-target-highlight-id'], 0, strlen($match)) === $match;

          // Set normal as the default only if a new section is added.
          if (!$is_update) {
            $form['layout_builder_style_container']['#default_value'] = ['section_margin_fixed_width_container'];
          }

        }
      }
      // Add our LBS heading before style options.
      _layout_builder_custom_add_lbs_heading($form);

      break;
  }
  // If this is a layout builder form, add our custom library and cookie domain.
  if (str_ends_with($form_id, '_layout_builder_form')) {
    $form['#attached']['library'][] = 'layout_builder_custom/layout_builder_custom.overrides';
    $cookie_domain = getenv('AH_SITE_ENVIRONMENT') ? '.artsci.edu' : '.artsci.ddev.site';
    $form['#attached']['drupalSettings']['layoutBuilderCustom']['cookieDomain'] = $cookie_domain;
  }
}

/**
 * Custom validation for layout_builder_add/update_block form.
 *
 * @param array $form
 *   The form element.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function _layout_builder_custom_block_validate(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof ConfigureBlockFormBase) {
    /** @var \Drupal\layout_builder\SectionComponent $component */
    $component = $form_object->getCurrentComponent();

    // Run unique_id clean for when the AJAX callback is not triggered.
    if ($unique_id = $form_state->getValue('unique_id')) {
      $form_state->setValue('unique_id', Html::cleanCssIdentifier($unique_id));
    }

    switch ($component->getPluginId()) {
      case 'inline_block:artsci_banner':
        BannerBlockFormHandler::validateForm($form, $form_state);
        break;

      case 'inline_block:artsci_card':
        CardBlockFormHandler::validateForm($form, $form_state);
        break;

      case 'inline_block:artsci_slider':
        SliderBlockFormHandler::validateForm($form, $form_state);
        break;

      case 'inline_block:artsci_statistic':
        $block_form = $form_state->getValue('settings')['block_form'];
        $prefix = $block_form['field_artsci_statistic_title_pre'][0]['value'];
        $suffix = $block_form['field_artsci_statistic_title_suf'][0]['value'];
        if (strlen($prefix) > 3) {
          $form_state->setErrorByName('settings][block_form][field_artsci_statistic_title_pre', t('Prefix cannot exceed 3 characters.'));
        }
        if (strlen($suffix) > 3) {
          $form_state->setErrorByName('settings][block_form][field_artsci_statistic_title_suf', t('Suffix cannot exceed 3 characters.'));
        }
        break;

      case 'menu_block:main':
        // If follow is checked...
        if ((int) $form_state->getValue(['settings', 'follow']) === 1) {
          // Set parent to default.
          $form_state->setValue(['settings', 'parent'], 'main:');
          // Set level = 1.
          $form_state->setValue(['settings', 'level'], 1);
        }
        break;
    }
  }
}

/**
 * Custom submit handler for layout_builder_add/update_block form.
 *
 * @param array $form
 *   The form element.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function _layout_builder_custom_block_submit(array &$form, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof ConfigureBlockFormBase) {
    /** @var \Drupal\layout_builder\SectionComponent $component */
    $component = $form_object->getCurrentComponent();
    $block = $component->getPlugin();

    // Save the third-party value if set, otherwise unset it.
    if ($unique_id = $form_state->getValue('unique_id')) {
      $component->setThirdPartySetting('layout_builder_custom', 'unique_id', $unique_id);
    }
    else {
      $component->unsetThirdPartySetting('layout_builder_custom', 'unique_id');
    }

    switch ($block->getPluginId()) {
      case 'inline_block:artsci_banner':
        BannerBlockFormHandler::submitForm($form, $form_state);
        break;
      case 'inline_block:artsci_slider':
        SliderBlockFormHandler::submitForm($form, $form_state);
        break;
      case 'inline_block:artsci_card':
        // Force default values for hidden style fields.
        CardBlockFormHandler::submitForm($form, $form_state);
        break;
      case 'inline_block:featured_content':
        // $form_state->setValue('layout_builder_style_list_format', 'list_format_grid');
        $form_state->setValue('layout_builder_style_margin', 'block_margin_default_removed');
        
        break;
      case 'inline_block:artsci_aggregator':
      case 'views_block:article_list_block-list_article':
      case 'views_block:article_list_block-list_article_recent':
      case 'views_block:page_list_block-list_page':
      case 'views_block:events-card_list':
      case 'views_block:image_card_list_block-list_image_card':
      case 'views_block:people_list_block-list_card':
        $media_position = $form_state->getValue('layout_builder_style_card_media_position');
        $media_format = $form_state->getValue('layout_builder_style_media_format');

        // If the media position is stacked and the media format is square or
        // widescreen, set the media size to large.
        //  if ($media_position === '' && in_array($media_format, [
        //   'media_format_widescreen',
        //   'media_format_square',
        // ])) {
        //   $form_state->setValue('layout_builder_style_media_size', 'media_size_medium');
        // }

        if ($block->getPluginId() === 'inline_block:artsci_card') {
          // Remove image or icon based on media_options selection.
          $media_option = $form_state->getValue([
            'settings',
            'block_form',
            'media_types',
          ]);

          if ($media_option) {

            $form_image_selection = [
              'settings',
              'block_form',
              'field_artsci_card_image',
              'selection',
            ];

            $form_icon_selection = [
              'settings',
              'block_form',
              'field_icon',
              0,
              'value',
              'icon',
            ];

            if ($media_option === 'image') {
              if ($form_state->hasValue($form_icon_selection)) {
                $form_state->unsetValue($form_icon_selection);
              }
            }
            elseif ($media_option === 'icon') {
              if ($form_state->hasValue($form_image_selection)) {
                $form_state->unsetValue($form_image_selection);
              }
            }

            // Save as a third-party setting.
            if (!empty($media_option)) {
              $component->setThirdPartySetting('layout_builder_custom', 'media_types', $media_option);
            }
          }

          // Make sure button display field is checked
          // if the link title field is filled in.
          $link_title = $form_state->getValue(
            [
              'settings',
              'block_form',
              'field_artsci_card_link',
            ]
            )[0]['title'];
          if ($link_title) {
            $form_state->setValue(
            [
              'settings',
              'block_form',
              'field_artsci_card_button_display',
            ],
            [
              'value' => 1,
            ],
            );
          }
        }
        break;

      case 'inline_block:artsci_collection':
        // Move the view mode value back out of the block form.
        $view_mode = $form_state->getValue(
          [
            'settings',
            'block_form',
            'view_mode',
          ]
        );
        $form_state->setValue(
          [
            'settings',
            'view_mode',
          ],
          $view_mode
        );
        break;

    }
  }
}

/**
 * Custom process block form elements.
 *
 * @param array $element
 *   The current block element.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current form state.
 *
 * @return array
 *   The processed block element.
 */
function _layout_builder_custom_process_element(array $element, FormStateInterface $form_state) {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof ConfigureBlockFormBase) {
    /** @var \Drupal\layout_builder\SectionComponent $component */
    $component = $form_object->getCurrentComponent();
    $block = $component
      ->getPlugin();

    switch ($block->getPluginId()) {
      case 'inline_block:artsci_text_area':
        if (isset($element['field_artsci_headline']['widget'][0]['container'])) {
          $container = &$element['field_artsci_headline']['widget'][0]['container'];
          
          // Hide heading size field and default to h2.
          if (isset($container['heading_size'])) {
            $container['heading_size']['#access'] = FALSE;
            $container['heading_size']['#default_value'] = 'h2';
          }
          
          // Hide child heading size field and default to h2.
          if (isset($container['child_heading_size'])) {
            $container['child_heading_size']['#access'] = FALSE;
            $container['child_heading_size']['#default_value'] = 'h2';
          }
        }
        break;

      case 'inline_block:artsci_banner':
        return BannerBlockFormHandler::processElement($element, $form_state);

      case 'inline_block:artsci_slider':
        return SliderBlockFormHandler::processElement($element, $form_state);

      case 'inline_block:artsci_card':
        // Hide heading size field and default to h2.
        return CardBlockFormHandler::processElement($element, $form_state);
        if (isset($element['field_artsci_card_title']['widget'][0]['container']['size'])) {
          $element['field_artsci_card_title']['widget'][0]['container']['size']['#access'] = FALSE;
          $element['field_artsci_card_title']['widget'][0]['container']['size']['#default_value'] = 'h2';
        }
        if (isset($element['field_artsci_card_button_display'])) {
          $element['field_artsci_card_button_display']['widget']['#options']['_none'] = 'Use site default';
          $element['field_artsci_card_button_display']['widget']['#description'] .= t('&nbsp;If "Use site default" is selected, this setting can be changed on the <a href="@settings_url">artsci Pages settings</a>.', [
            '@settings_url' => Url::fromRoute("artsci_pages.settings_form")
              ->toString(),
          ]);
          $element['field_artsci_card_button_display']['#states'] = [
            'visible' => [
              ':input[name="settings[block_form][field_artsci_card_link][0][uri]"]' => [
                'filled' => TRUE,
              ],
              ':input[name="settings[block_form][field_artsci_card_link][0][title]"]' => [
                'filled' => FALSE,
              ],
            ],
          ];
        }
        break;

      case 'inline_block:artsci_collection':
        if (isset($element['field_artsci_headline']['widget'][0]['container'])) {
          $container = &$element['field_artsci_headline']['widget'][0]['container'];
          
          // Hide heading size field and default to h2.
          if (isset($container['heading_size'])) {
            $container['heading_size']['#access'] = FALSE;
            $container['heading_size']['#default_value'] = 'h2';
          }
          
          // Hide child heading size field and default to h2.
          if (isset($container['child_heading_size'])) {
            $container['child_heading_size']['#access'] = FALSE;
            $container['child_heading_size']['#default_value'] = 'h2';
          }
        }

        // Default to multiselect and remove the empty option.
        $element['field_accordion_type']['widget']['#default_value'] = $element['field_accordion_type']['widget']['#default_value'] ?? 'multi_select';
        unset($element['field_accordion_type']['widget']['#options']['_none']);
        // Only show the "accordion type" field if accordion view mode
        // has been selected.
        $element['field_accordion_type']['widget']['#states'] = [
          'visible' => [
            ':input[name="settings[block_form][view_mode]"]' => [
              'value' => 'accordion',
            ],
          ],
        ];

        // Default to gray.
        $element['field_accordion_label_color']['widget']['#default_value'] = $element['field_accordion_label_color']['widget']['#default_value'] ?? 'gray_default';
        // Only show the "accordion label color" field
        // if accordion view mode has been selected.
        $element['field_accordion_label_color']['widget']['#states'] = [
          'visible' => [
            ':input[name="settings[block_form][view_mode]"]' => [
              'value' => 'accordion',
            ],
          ],
        ];

        // Now that we have view mode on the block form, place the fields
        // in the right order.
        $element['view_mode']['#weight'] = 2;
        $element['field_accordion_type']['#weight'] = 3;
        $element['field_artsci_collection_items']['#weight'] = 4;
        $element['field_accordion_label_color']['#weight'] = 5;

        break;

      case 'inline_block:artsci_aggregator':
      case 'inline_block:artsci_image_gallery':
      case 'inline_block:artsci_image':
      case 'inline_block:featured_content':
        if (isset($element['field_artsci_headline']['widget'][0]['container'])) {
          $container = &$element['field_artsci_headline']['widget'][0]['container'];
          
          // Hide heading size field and default to h2.
          if (isset($container['heading_size'])) {
            $container['heading_size']['#access'] = FALSE;
            $container['heading_size']['#default_value'] = 'h2';
          }
          
          // Hide child heading size field and default to h2.
          if (isset($container['child_heading_size'])) {
            $container['child_heading_size']['#access'] = FALSE;
            $container['child_heading_size']['#default_value'] = 'h2';
          }
        }
      
        break;

    }
  }
  return $element;
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 */
function layout_builder_custom_field_widget_single_element_paragraphs_form_alter(array &$element, FormStateInterface &$form_state, array $context) {
  if (isset($element['#paragraph_type'])) {
    switch ($element['#paragraph_type']) {
      case 'artsci_timeline_item':
        if (isset($element['subform']['field_timeline_icon']['widget'][0])
          && is_array($element['subform']['field_timeline_icon']['widget'][0])) {
          artsci_core_configure_fontawesome_icon_field($element['subform']['field_timeline_icon']['widget'][0]);
        }
        break;
    }
  }
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 */
function layout_builder_custom_field_widget_single_element_linkit_attributes_form_alter(array &$element, FormStateInterface &$form_state, array $context) {
  if (!\Drupal::currentUser()
    ->hasPermission('administer link field attributes')) {
    $element['options']['attributes']['#access'] = FALSE;
  }
  // if (isset($element['options']['attributes']['data-sn-event-component'])) {
  //   // The default for this is set on a per-component basis,
  //   // e.g. in the BannerBlockFormHandler,
  //   // and should not be set by the user.
  //   $element['options']['attributes']['data-sn-event-component']['#access'] = FALSE;
  // }
  // if (isset($element['options']['attributes']['data-sn-event-type'])) {
  //   // The default for this is set platform-wide as 'click'
  //   // in artsci_core_link_attributes_plugin_alter, so
  //   // remove access to change.
  //   $element['options']['attributes']['data-sn-event-type']['#access'] = FALSE;
  // }
}

/**
 * Add an element to delineate the layout builder styles form section.
 *
 * The weights are important here. The layout_builder_custom module weighs all
 * fields at 90. We weigh single-select fields at 89 when configuring a section.
 *
 * @see: layout_builder_custom_form_alter().
 */
function _layout_builder_custom_add_lbs_heading(&$form) {
  $children = Element::children($form);

  $styles = array_filter($children, function ($v) {
    return (strpos($v, 'layout_builder_style_') === 0);
  });

  if (!empty($styles)) {
    $form['lbs_heading'] = [
      '#type' => 'container',
      '#attributes' => [
        'class' => [
          'layout-builder-style-heading',
        ],
      ],
      'markup' => [
        '#prefix' => '<span>',
        '#markup' => t('Display options'),
        '#suffix' => '</span>',
      ],
      '#weight' => 80,
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function layout_builder_custom_preprocess_block(&$variables) {
  // Unset grid_columns classes if display as list.
  if (isset($variables['attributes']['class'])) {

    $allowlist = [
      'views_block:article_list_block-list_article',
      'views_block:article_list_block-list_article_recent',
      'views_block:article_list_block-list_book',
      'views_block:article_list_block-list_event',
      'views_block:article_list_block-list_person',
      'views_block:events-card_list',
      'views_block:page_list_block-list_page',
      'views_block:image_card_list_block-list_image_card',
      'views_block:people_list_block-list_card',
      'views_block:student_card-block_student_card',
    ];

    if ($variables['base_plugin_id'] === 'views_block') {
      // Check if the current block plugin ID is in the allowlist.
      $current_plugin_id = $variables['plugin_id'];
      if (in_array($current_plugin_id, $allowlist)) {

        // Filter out any card styles.
        $card_styles = Card::filterCardStyles($variables['attributes']['class']);
        $variables['attributes']['class'] = array_diff($variables['attributes']['class'], $card_styles);

        // Get a list of formatting styles that will be displayed
        // on the view instead of the block and remove them.
        $filtered_styles = LayoutBuilderStylesHelper::filterStyles($variables['attributes']['class'], [
          LayoutBuilderStylesHelper::LIST_PREFIX,
          LayoutBuilderStylesHelper::GRID_PREFIX,
        ]);
        LayoutBuilderStylesHelper::removeStylesFromAttributes($variables['attributes'], $filtered_styles);
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for block__inline_block__featured_content.
 */
function layout_builder_custom_preprocess_block__inline_block__featured_content(&$variables) {
  $variables['#attached']['library'][] = 'atomic_artsci/node-type-article';
  if (!isset($variables['attributes']['class'])) {
    $variables['attributes']['class'] = [];
  }

  LayoutBuilderStylesHelper::processGridClasses($variables['attributes']);
  $variables['attributes']['class'][] = 'list-container';

  // Build the list of referenced item cards. Heading size and override styles
  // are applied per item below; the original field render is removed at the end.
  $variables['content']['referenced_items'] = [];

  /** @var \Drupal\block_content\Entity\BlockContent $block */
  $block = $variables['content']['#block_content'];

  $override_styles = $variables['elements']['#override_styles'] ?: [];

  // This is a single value field.
  $headline_field = $block->field_artsci_headline;

  if (empty($headline_field?->headline)) {
    $heading_size = $headline_field?->child_heading_size;
  }
  else {
    $heading_size = HeadlineHelper::getHeadingSizeUp($headline_field?->heading_size);
    // Add grid modifier class to exclude headline for rendering in grid.
    $lb_styles_array = $variables['elements']['#layout_builder_style'] ?? [];
  }

  // Reuse the per-item builds the entity reference formatter already produced
  // instead of re-rendering each node by hand. Decorate each card build with
  // the heading size and override styles, wrap it in a column-container, and
  // let it render lazily with the rest of the block. This matches how
  // aggregator items pick up override styles through the normal pipeline and
  // avoids the standalone render pass that produced a duplicate item render.
  $items = $variables['content']['field_featured_content_item'] ?? [];
  foreach (Element::children($items) as $delta) {
    $build = $items[$delta];
    $build['#title_heading_size'] = $heading_size;
    $build['#prefix'] = '<div class="column-container">';
    $build['#suffix'] = '</div>';

    if (!empty($override_styles)) {
      $build['#override_styles'] = $override_styles;
    }

    $variables['content']['referenced_items'][] = $build;
  }

  // Drop the original field render so only the flattened cards above remain;
  // this keeps the entity reference field wrapper from sitting between the
  // grid container and the cards.
  unset($variables['content']['field_featured_content_item']);
}

/**
 * Implements hook_preprocess_HOOK() for block__inline_block__artsci_banner.
 */
function layout_builder_custom_preprocess_block__inline_block__artsci_banner(&$variables) {
  $block = $variables['elements']['content']['#block_content'];
  // Media entity template needs to change based on this block,
  // so invalidate cache.
  if ($block->hasField('field_artsci_banner_image') && !$block->get('field_artsci_banner_image')->isEmpty()) {
    $id = $block->get('field_artsci_banner_image')->target_id;
    Cache::invalidateTags(['media:' . $id]);
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function layout_builder_custom_preprocess_layout(&$variables) {
  // Apply a configured style to a layout by adding the style's CSS classes.
  if (isset($variables['settings']['layout_builder_custom_unique_id'])) {
    $variables['attributes']['id'] = $variables['settings']['layout_builder_custom_unique_id'];
  }

  // Process section headline configuration.
  if (!empty($variables['settings']['layout_builder_custom_headline'])) {
    $headline_config = $variables['settings']['layout_builder_custom_headline'];

    // Get styles from HeadlineHelper.
    $style_map = HeadlineHelper::getStyles();
    $alignment_map = HeadlineHelper::getHeadingAlignment();

    $variables['section_headline'] = [
      'pre_headline' => $headline_config['pre_headline'] ?? '',
      'text' => $headline_config['headline'],
      'size' => $headline_config['heading_size'] ?? 'h2',
      'styles' => $style_map[$headline_config['headline_style'] ?? 'default'] ?? 'headline block__headline',
      'alignment' => $alignment_map[$headline_config['headline_alignment'] ?? 'default'] ?? 'headline--left',
      'hide_headline' => !empty($headline_config['hide_headline']),
    ];
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function layout_builder_custom_preprocess_media(&$variables) {
  $media = $variables['elements']['#media'];
  switch ($media->bundle()) {
    case 'remote_video':
    case 'video':
      $variables['attributes']['class'][] = 'media--video';
      break;
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function layout_builder_custom_preprocess_views_view(&$variables) {

  /** @var \Drupal\views\ViewExecutable $view */
  $view = $variables['view'];

  if ($view->display_handler instanceof ListBlock) {

    // Initialize some empty arrays that might be processed.
    $hide_fields = [];
    $override_styles = [];
    $view_styles = [];

    // Initialize the class list, if it doesn't exist.
    if (!isset($variables['attributes']['class'])) {
      $variables['attributes']['class'] = [];
    }

    // Check if we have Layout Builder Styles to process.
    if (!is_null($layout_builder_styles = $view
      ?->display_handler
      ?->getOption('layout_builder_styles'))) {

      // Convert the style list into a map that can be used for overriding
      // style defaults later.
      $style_map = LayoutBuilderStylesHelper::getLayoutBuilderStylesMap($layout_builder_styles);

      // Filter the style map to just classes related to the card.
      $override_styles = Card::filterCardStyles($style_map);

      // A list of styles to pull from the block to display on the view.
      $filter_prefixes = [LayoutBuilderStylesHelper::LIST_PREFIX];

      // If this is meant to display as a grid, add that prefix.
      if (!in_array('list-container--list', $style_map)) {
        $filter_prefixes[] = LayoutBuilderStylesHelper::GRID_PREFIX;
      }

      // Get the filtered list of styles.
      $view_styles = LayoutBuilderStylesHelper::filterStyles($style_map, $filter_prefixes);
    }

    // Construct the new array of classes to display.
    $variables['attributes']['class'] = [
      ...$variables['attributes']['class'],
      ...array_values($view_styles),
    ];

    if (!is_null($block_config = $view
      ?->display_handler
      ?->getOption('block_config'))) {

      // Build the list of fields to hide.
      if (isset($block_config['fields'])) {
        foreach ($block_config['fields'] as $field_name => $hide_field) {
          if ((int) $hide_field['hide'] === 1) {
            $hide_fields[] = $field_name;
          }
        }
      }
    }

    // Check if there are view rows to act upon.
    if (isset($variables['rows'][0]['#rows'])) {

      // Loop through view rows and set styles to override and hidden
      // fields.
      foreach ($variables['rows'][0]['#rows'] as &$row_build) {

        if (!empty($override_styles)) {
          $row_build['#override_styles'] = $override_styles;
        }
        if (!empty($hide_fields)) {
          $row_build['#hide_fields'] = $hide_fields;
        }
      }
    }

    // NOTE: Do NOT reset static variables here!
    // Entity rendering happens AFTER preprocessing (when Twig renders rows),
    // so the static must persist until then. The reset happens at the START
    // of the next view's pre_render hook instead.
  }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function layout_builder_custom_preprocess_views_view_unformatted(&$variables) {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $variables['view'];

  // If there is a heading size set, pass it through to the row content.
  if ($heading_size = $view?->display_handler?->getOption('heading_size')) {
    foreach ($variables['rows'] as &$row_build) {
      $row_build['content']['#title_heading_size'] = $heading_size;
    }
  }
}

/**
 * Implements hook_views_plugins_display_alter().
 */
function layout_builder_custom_views_plugins_display_alter(&$displays) {
  $moduleHandler = \Drupal::service('module_handler');

  // Swap the block class if it can be swapped.
  if (!empty($displays['block']['class']) && $displays['block']['class'] === Block::class) {
    $displays['block']['class'] = ListBlock::class;
  }
}

/**
 * Implements hook_views_pre_build().
 */
function layout_builder_custom_views_pre_build(ViewExecutable $view) {
  // Dynamically set pager id using cache.
  // Temp workaround until https://www.drupal.org/project/drupal/issues/3225987.
  $pager = $view->display_handler->getOption('pager');
  if (isset($pager) && $pager['type'] === 'full') {
    if ($cached = \Drupal::cache('layout_builder_custom_views_pager_elements')->get($view->dom_id)) {
      $pager['options']['id'] = $cached->data;
    }
    else {
      $pager_manager = \Drupal::service('pager.manager');
      \Drupal::cache('layout_builder_custom_views_pager_elements')->set($view->dom_id, $pager_manager->getMaxPagerElementId() + 1, Cache::PERMANENT);
      $cached = \Drupal::cache('layout_builder_custom_views_pager_elements')->get($view->dom_id);
      $pager['options']['id'] = $cached->data;
    }
    $view->display_handler->setOption('pager', $pager);
  }
}

/**
 * Implements hook_views_pre_render().
 */
function layout_builder_custom_views_pre_render(ViewExecutable $view) {
  // Hotfix shim to not display exposed blocks, necessary because
  // of the hotfix above.
  $display = $view->getDisplay();
  $exceptions = [
    'block_people_slf',
    'block_people_sfl',
    'article_list_block',
    'block_articles',
    'list_article',
    'list_event',
    'list_people',
  ];
  if (!in_array($display->display['id'], $exceptions) && $view->display_handler instanceof ListBlock) {
    $view->exposed_raw_input = [];
  }

  // Inject card override styles and hide_fields BEFORE entities render.
  // Use drupal_static so entities can access during buildCard().
  if ($view->display_handler instanceof ListBlock) {
    // Clear previous block's styles BEFORE setting new ones.
    // This must happen here, not in preprocess_views_view, because entity
    // rendering happens AFTER preprocessing (when Twig renders the rows).
    drupal_static_reset('layout_builder_custom_card_override_styles');
    drupal_static_reset('layout_builder_custom_card_hide_fields');

    $layout_builder_styles = $view->display_handler->getOption('layout_builder_styles');

    if (!empty($layout_builder_styles)) {
      $style_map = LayoutBuilderStylesHelper::getLayoutBuilderStylesMap($layout_builder_styles);
      $override_styles = Card::filterCardStyles($style_map);
      // Store in static so entities can access during buildCard().
      $static_styles = &drupal_static('layout_builder_custom_card_override_styles');
      $static_styles = $override_styles;
      // Also attach to view for backward compatibility.
      $view->card_override_styles = $override_styles;
    }

    $block_config = $view->display_handler->getOption('block_config');
    if (!empty($block_config['fields'])) {
      $hide_fields = [];
      foreach ($block_config['fields'] as $field_name => $hide_field) {
        if ((int) $hide_field['hide'] === 1) {
          $hide_fields[] = $field_name;
        }
      }
      // Store in static so entities can access during buildCard().
      $static_hide_fields = &drupal_static('layout_builder_custom_card_hide_fields');
      $static_hide_fields = $hide_fields;
      // Also attach to view for backward compatibility.
      $view->card_hide_fields = $hide_fields;
    }
  }
}

/**
 * Ajax callback for unique_id field.
 *
 * @param array $form
 *   The form array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 *
 * @return mixed
 *   The form element.
 */
function _layout_builder_custom_unique_id(array &$form, FormStateInterface $form_state) {
  $triggering_element = $form_state->getTriggeringElement();
  $triggering_element['#value'] = Html::cleanCssIdentifier($triggering_element['#value']);
  return $triggering_element;
}

/**
 * Allowed values callback for banner midpoint percentage options.
 *
 * @return array
 *   An array of allowed values with percentage options.
 */
function _layout_builder_custom_banner_midpoint_options() {
  return [
    '20%' => '20%',
    '30%' => '30%',
    '40%' => '40% (default for vertical directions)',
    '50%' => '50%',
    '60%' => '60%',
    '70%' => '70% (default for horizontal direction)',
  ];
}


/**
 * ---------------------------------------------------------------------------
 * artsci_slider render-stage logic.
 *
 * Relocated from atomic_artsci.theme so the slider's render handling lives in
 * the same module as SliderBlockFormHandler. Module preprocess hooks run
 * before theme hooks, so the block preprocess still populates the static
 * bridge before the slide paragraphs are preprocessed.
 * ---------------------------------------------------------------------------
 */

/**
 * Removes a set of classes from an attributes array or Attribute object.
 *
 * @param array|\Drupal\Core\Template\Attribute|null $attributes
 *   The attributes container, passed by reference.
 * @param string[] $classes
 *   Class names to remove.
 */
function _layout_builder_custom_strip_classes(&$attributes, array $classes): void {
  if (is_array($attributes)) {
    if (!empty($attributes['class']) && is_array($attributes['class'])) {
      $attributes['class'] = array_values(array_diff($attributes['class'], $classes));
    }
  }
  elseif ($attributes instanceof \Drupal\Core\Template\Attribute) {
    $attributes->removeClass($classes);
  }
}

/**
 * Maps a carousel size to the number of slides visible per page.
 *
 * @param string $size
 *   One of 'four', 'three', 'two', 'one'.
 *
 * @return float
 *   Slides per page. Returns float because 'paged' is 2.5.
 */
function _layout_builder_custom_carousel_per_page(string $size): float {
  $map = [
    'four' => 4,
    'three' => 3,
    'two' => 2.5,
    'one'  => 1,
  ];
  return $map[$size] ?? 3;
}

/**
 * Stores/retrieves slider context for a block content entity.
 *
 * Bridges block preprocess (has LB Styles) to paragraph preprocess (doesn't).
 *
 * @param int|string $block_content_id
 *   The block content entity ID.
 * @param array|null $context
 *   If provided, stores this context. If NULL, retrieves.
 *
 * @return array
 *   The slider context array.
 */
function _layout_builder_custom_slider_context_bridge($block_content_id, ?array $context = NULL): array {
  static $contexts = [];

  if ($context !== NULL) {
    $contexts[$block_content_id] = $context;
  }

  return $contexts[$block_content_id] ?? [
    'carousel_size' => 'three',
    'carousel_per_page' => 3,
    'media_format' => NULL,
    'media_position' => NULL,
    'media_size' => NULL,
  ];
}

/**
 * Resolves the media view mode for a slide from its parent slider context.
 *
 * @param array $ctx
 *   The slider context. Its media_format and media_size are view mode family
 *   names and size tiers, not CSS classes, so they concatenate directly.
 * @param string $bundle
 *   The media bundle of the slide's media.
 *
 * @return string|null
 *   The {size}__{format} view mode, or NULL when no enabled display exists for
 *   that bundle. NULL leaves the media on the view mode pinned in the slide's
 *   paragraph display.
 */
function _layout_builder_custom_slide_media_view_mode(array $ctx, string $bundle): ?string {
  // Fallbacks for a slider saved before the media style defaults existed.
  // Medium rather than full: a slide is never full-bleed in any carousel size,
  // and full__* declares the 1310px sizes clause and a full-tier fallback
  // image, which is what made slider posters the heaviest assets on the page.
  $format = $ctx['media_format'] ?? 'widescreen';
  $size = $ctx['media_size'] ?? 'medium';

  // Circle has no view mode family of its own; it is a CSS mask over a square
  // crop.
  if ($format === 'circle') {
    $format = 'square';
  }

  $view_mode = "{$size}__{$format}";

  return LayoutBuilderStylesHelper::mediaViewDisplayExists($bundle, $view_mode)
    ? $view_mode
    : NULL;
}

/**
 * Implements hook_preprocess_HOOK() for block--inline-block--artsci-slider.
 *
 * Extracts carousel settings and card styles from Layout Builder Styles.
 * Bridges context to child paragraphs via static storage.
 */
function layout_builder_custom_preprocess_block__inline_block__artsci_slider(&$variables) {
  // Default carousel settings.
  // Per-page is derived from carousel_size below; do not hardcode here.
  $variables['carousel_size'] = 'three';
  $variables['carousel_per_page'] = _layout_builder_custom_carousel_per_page('three');
  $variables['carousel_loop'] = TRUE;
  $variables['carousel_autoplay'] = NULL;
  // Number of slides. The template uses this to render the nav controls only
  // when there is more than one slide to navigate.
  $variables['slide_count'] = 0;

  // Get the block content entity.
  $block = NULL;
  if (isset($variables['elements']['content']['#block_content'])) {
    $block = $variables['elements']['content']['#block_content'];

    // Count the slides so the template can hide the nav controls when there is
    // only a single slide.
    if ($block->hasField('field_artsci_slider_slides')) {
      $variables['slide_count'] = $block->get('field_artsci_slider_slides')->count();
    }

    // Extract headline for large carousel mode.
    if ($block->hasField('field_artsci_headline') && !$block->get('field_artsci_headline')->isEmpty()) {
      $headline_field = $block->get('field_artsci_headline')->first();
      if ($headline_field) {
        $values = $headline_field->getValue();
        $variables['headline_text'] = $values['headline'] ?? NULL;
        $variables['pre_title'] = $values['pre_headline'] ?? NULL;
      }
    }
  }

  // Extract styles from Layout Builder Styles classes.
  $classes = $variables['elements']['#attributes']['class'] ?? [];

  // Initialize slider context for bridging to paragraphs.
  $slider_context = [
    'carousel_size' => 'three',
    'carousel_per_page' => _layout_builder_custom_carousel_per_page('three'),
    'media_format' => NULL,
    'media_position' => NULL,
    'media_size' => NULL,
  ];

  // Carousel size mapping. The LB style class determines the size, which in
  // turn determines slides per page via _layout_builder_custom_carousel_per_page().
  $size_map = [
    'carousel--four' => 'four',
    'carousel--three' => 'three',
    'carousel--two' => 'two',
    'carousel--one'  => 'one',
  ];
  foreach ($size_map as $class => $size) {
    if (in_array($class, $classes)) {
      $variables['carousel_size'] = $size;
      $slider_context['carousel_size'] = $size;
      break;
    }
  }

  // Derive per_page from the resolved size (single source of truth).
  $variables['carousel_per_page'] = _layout_builder_custom_carousel_per_page($variables['carousel_size']);

  // Media format mapping. The value is the media view mode FAMILY, which the
  // slide preprocess concatenates with the size tier to build {size}__{format}.
  $format_map = [
    'media--circle' => 'circle',
    'media--landscape' => 'landscape',
    'media--square' => 'square',
    'media--widescreen' => 'widescreen',
    'media--portrait' => 'portrait',
  ];
  foreach ($format_map as $class => $format) {
    if (in_array($class, $classes)) {
      $slider_context['media_format'] = $format;
      break;
    }
  }

  // Media position mapping (card layout).
  $position_map = [
    'card--layout-left' => 'left',
    'card--layout-right' => 'right',
    'card--stacked' => 'stacked',
    'card--layout-overlay' => 'overlay',
  ];
  foreach ($position_map as $class => $position) {
    if (in_array($class, $classes)) {
      $slider_context['media_position'] = $position;
      break;
    }
  }

  // Media size mapping.
  $size_style_map = [
    'media--small' => 'small',
    'media--medium' => 'medium',
    'media--large' => 'large',
  ];
  foreach ($size_style_map as $class => $size) {
    if (in_array($class, $classes)) {
      $slider_context['media_size'] = $size;
      break;
    }
  }

  // Check for autoplay class.
  if (in_array('carousel--autoplay', $classes)) {
    $variables['carousel_autoplay'] = 5000;
  }

  // Check for no-loop class.
  if (in_array('carousel--no-loop', $classes)) {
    $variables['carousel_loop'] = FALSE;
  }

  // Store context in per_page variable too.
  $slider_context['carousel_per_page'] = $variables['carousel_per_page'];

  // The card-level LB styles (card_media_position, media_format, media_size)
  // are meant for the individual slide cards, not the slider block wrapper.
  // layout_builder_styles applies them to the block's #attributes; if they
  // remain on the .artsci-slider wrapper, global card.scss rules such as
  // `.card--layout-left { display: flex; flex-direction: row }` match the
  // wrapper itself and lay the whole block (headline + track + nav) out in a
  // row. They've been captured in $slider_context above, so strip them from
  // the wrapper now; the slide template re-applies them to .card and .media.
  $relocated_classes = [
    'card--layout-left',
    'card--layout-right',
    'card--stacked',
    'card--layout-overlay',
    'media--circle',
    'media--border',
    'media--landscape',
    'media--square',
    'media--widescreen',
    'media--portrait',
    'media--small',
    'media--medium',
    'media--large',
  ];

  // Button style LB group ("bttn bttn--primary--reverse", "bttn bttn--tertiary",
  // "bttn bttn--transparent", "bttn bttn--arrow--red") and the
  // button-align-bottom card style are card-level too. Capture them for the
  // card's button (the card embed applies them) and relocate them off the
  // wrapper, the same way the banner block reads bttn* classes. LB stores the
  // multiple classes of one style as a single space-separated entry, so split.
  $button_classes = [];
  foreach ($classes as $cls) {
    if (!is_string($cls)) {
      continue;
    }

    elseif (str_starts_with($cls, 'bttn')) {
      foreach (preg_split('/\s+/', trim($cls)) as $part) {
        if ($part !== '') {
          $button_classes[] = $part;
        }
      }
      $relocated_classes[] = $cls;
    }
  }
  if (!empty($button_classes)) {
    $slider_context['button_classes'] = array_values(array_unique($button_classes));
  }

  if (isset($variables['attributes'])) {
    _layout_builder_custom_strip_classes($variables['attributes'], $relocated_classes);
  }
  if (isset($variables['elements']['#attributes'])) {
    _layout_builder_custom_strip_classes($variables['elements']['#attributes'], $relocated_classes);
  }

  // Bridge context to child paragraphs via static storage.
  if ($block) {
    _layout_builder_custom_slider_context_bridge($block->id(), $slider_context);
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph--artsci-slide.
 *
 * Reads parent slider context, extracts slide field values into clean
 * template variables, and builds the card class list from
 * media_format / media_position / media_size so the card.scss rules apply.
 */
function layout_builder_custom_preprocess_paragraph__artsci_slide(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  // Default slider context (used when no parent block context is available,
  // e.g. when previewing the paragraph in isolation).
  $variables['slider_context'] = [
    'carousel_size' => 'three',
    'media_format' => NULL,
    'media_position' => NULL,
    'media_size' => NULL,
  ];

  // Read slider context from static bridge (set by block preprocess).
  $parent = $paragraph->getParentEntity();
  if ($parent && $parent instanceof \Drupal\block_content\BlockContentInterface) {
    $variables['slider_context'] = _layout_builder_custom_slider_context_bridge($parent->id());
  }

  $ctx = $variables['slider_context'];

  // Build two separate class lists from slider context. The card.scss rules
  // are scoped so that:
  //   - position classes (card--layout-*, card--stacked) go on the .card
  //     element, e.g. `.card--layout-left { display: flex }`
  //   - format + size classes (media--*) go on the inner .media element,
  //     e.g. `.card .media--square img { aspect-ratio: 1/1 }`
  // Splitting them is essential: putting media--* on the .card produces
  // `.card.media--square`, which matches none of the descendant rules.
  $card_classes = [];
  $media_classes = [];

  // Position -> on the .card element (via the embed's `attributes`).
  // The 2.5 "two" peek style is built around overlay cards (full-bleed image
  // with the text over a panel); that overlay layout is what hosts the
  // active-slide teal panel in slider-carousel.scss. Force it for that size
  // regardless of the media position style the editor picked, so the teal
  // always has a host to attach to and follows the active slide on paginate.
  $position = ($ctx['carousel_size'] ?? NULL) === 'two'
    ? 'overlay'
    : ($ctx['media_position'] ?? NULL);
  if (!empty($position)) {
    // 'stacked' uses class 'card--stacked'; others use 'card--layout-X'.
    $card_classes[] = $position === 'stacked'
      ? 'card--stacked'
      : 'card--layout-' . $position;
  }

  // Format -> on the inner .media element (via the embed's `media_attributes`).
  if (!empty($ctx['media_format'])) {
    $media_classes[] = 'media--' . $ctx['media_format'];
    // The media_format_circle LB style also applies media--border; mirror it.
    if ($ctx['media_format'] === 'circle') {
      $media_classes[] = 'media--border';
    }
  }

  // Size -> on the inner .media element (combines with format, e.g.
  // `.media--small.media--circle`).
  if (!empty($ctx['media_size'])) {
    $media_classes[] = 'media--' . $ctx['media_size'];
  }

  // Button-align-bottom is a card-level style (card_style_button_position LB
  // group); apply it to the .card alongside the position classes.
  $card_classes[] = 'card--button-align-bottom';

  $variables['card_classes'] = $card_classes;
  $variables['media_classes'] = $media_classes;

  // Button style classes for the card's button (button_style LB group on the
  // slider block, captured in the block preprocess). NULL when none is
  // selected; the template falls back to a default.
  $variables['button_classes'] = !empty($ctx['button_classes'])
    ? $ctx['button_classes']
    : NULL;

  // Extract slide field values into clean template variables.
  $variables['slide_title'] = NULL;
  if ($paragraph->hasField('field_collection_headline') && !$paragraph->get('field_collection_headline')->isEmpty()) {
    $variables['slide_title'] = $paragraph->get('field_collection_headline')->value;
  }

  $variables['slide_summary'] = !empty($variables['content']['field_artsci_slide_content'])
    ? $variables['content']['field_artsci_slide_content']
    : NULL;

  $variables['slide_image'] = !empty($variables['content']['field_artsci_slide_image'])
    ? $variables['content']['field_artsci_slide_image']
    : NULL;

  // Render the slide media in the {size}__{format} view mode matching the
  // block's Layout Builder style, the same pipeline the card and image blocks
  // use. Without this the media falls back to the view mode pinned in
  // core.entity_view_display.paragraph.artsci_slide.default.yml
  // (field_artsci_slide_image => full__widescreen), so neither the format nor
  // the size selection reaches a responsive image style.
  //
  // $ctx already holds family names and size tiers, not CSS classes, so they
  // concatenate directly and must not be run back through a class map.
  //
  // For images the swap delivers a real server-side focal-point crop and the
  // matching responsive image style. For remote_video and video there is no
  // server-side crop, so the ratio still comes from CSS (.media--* in
  // card.scss); the swap still buys the per-display poster and play-label
  // settings.
  if ($paragraph->hasField('field_artsci_slide_image')
    && !$paragraph->get('field_artsci_slide_image')->isEmpty()) {
    $slide_media = $paragraph->get('field_artsci_slide_image')->entity;
    if ($slide_media instanceof \Drupal\media\MediaInterface) {
      $view_mode = _layout_builder_custom_slide_media_view_mode($ctx, $slide_media->bundle());
      if ($view_mode !== NULL) {
        $variables['slide_image'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($slide_media, $view_mode);
      }
    }
  }

  // Normalize the link field for the card embed. A link is allowed on every
  // slide except a remote_video one, so gate on the media bundle here. This is
  // the only place the template's `link` comes from, so leaving link_url/
  // link_text NULL makes every CTA path in the template (headline link, button,
  // media link, stat link) fall back to no-link without per-line guards. This
  // also covers legacy remote_video slides not re-saved through the presave
  // that clears their stale links.
  $variables['link'] = [
    'link_url' => NULL,
    'link_text' => NULL,
    'link_classes' => NULL,
  ];

  $slide_allows_link = TRUE;
  if ($paragraph->hasField('field_artsci_slide_image')
    && !$paragraph->get('field_artsci_slide_image')->isEmpty()) {
    $slide_media = $paragraph->get('field_artsci_slide_image')->entity;
    if ($slide_media instanceof \Drupal\media\MediaInterface
      && $slide_media->bundle() === 'remote_video') {
      $slide_allows_link = FALSE;
    }
  }
  // Exposed for the template in case an explicit guard is ever wanted there.
  $variables['slide_allows_link'] = $slide_allows_link;

  if ($slide_allows_link
    && $paragraph->hasField('field_artsci_slide_link')
    && !$paragraph->get('field_artsci_slide_link')->isEmpty()) {
    $link_item = $paragraph->get('field_artsci_slide_link')->first();
    try {
      $variables['link']['link_url'] = $link_item->getUrl()->toString();
    }
    catch (\Throwable $e) {
      // Invalid stored URL; leave as NULL.
    }
    $variables['link']['link_text'] = $link_item->title;
  }
}


/**
 * Implements hook_ENTITY_TYPE_presave() for paragraph entities.
 *
 * Enforces the slide data model: a remote_video slide must not carry a link.
 * When an artsci_slide's media is a remote_video, any stored link is cleared so
 * it cannot leak into the rendered output. The form hides the link for these
 * slides via #states, but #states only hides, it does not clear, so this keeps
 * the saved data in step with the UI. Image slides, local video slides, slides
 * with no media, and slides with no link are all left untouched.
 */
function layout_builder_custom_paragraph_presave(\Drupal\paragraphs\ParagraphInterface $paragraph) {
  if ($paragraph->bundle() !== 'artsci_slide') {
    return;
  }

  if (!$paragraph->hasField('field_artsci_slide_image')
    || !$paragraph->hasField('field_artsci_slide_link')) {
    return;
  }

  // Nothing to gate on if there is no media, and nothing to clear if there is
  // no link.
  if ($paragraph->get('field_artsci_slide_image')->isEmpty()
    || $paragraph->get('field_artsci_slide_link')->isEmpty()) {
    return;
  }

  $media = $paragraph->get('field_artsci_slide_image')->entity;
  if ($media instanceof \Drupal\media\MediaInterface && $media->bundle() === 'remote_video') {
    $paragraph->set('field_artsci_slide_link', NULL);
  }
}
