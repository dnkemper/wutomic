{#
/**
 * @file
 * Default theme implementation for the social share block.
 *
 * Available variables:
 * - heading: The heading text shown above the icons.
 * - links: An array of share links, each with a label, url, and icon.
 */
#}
<div class="social-share block-margin__top--extra">
  {% if heading %}
    <h3 class="event-details__heading">{{ heading }}</h3>
  {% endif %}
  <ul class="social-share__list">
    {% for link in links %}
      <li class="social-share__item">
        <a href="{{ link.url }}"
           class="social-share__link"
           target="_blank"
           rel="noopener noreferrer"
           title="{{ link.label }}">
          <span class="{{ link.icon }}" aria-hidden="true"></span>
          <span class="visually-hidden">{{ link.label }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
